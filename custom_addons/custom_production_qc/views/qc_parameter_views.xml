<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_qc_parameter_list" model="ir.ui.view">
        <field name="name">production.qc.parameter.list</field>
        <field name="model">production.qc.parameter</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="parameter_type"/>
                <field name="specification"/>
                <field name="uom_id"/>
                <field name="required"/>
            </list>
        </field>
    </record>

    <record id="view_qc_parameter_form" model="ir.ui.view">
        <field name="name">production.qc.parameter.form</field>
        <field name="model">production.qc.parameter</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <group>
                            <field name="template_id"/>
                            <field name="name"/>
                            <field name="parameter_type"/>
                            <field name="required"/>
                        </group>

                        <group>
                            <field name="specification"/>
                            <field name="uom_id"/>
                            <field name="min_value"/>
                            <field name="max_value"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_qc_parameter" model="ir.actions.act_window">
        <field name="name">QC Parameter</field>
        <field name="res_model">production.qc.parameter</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>