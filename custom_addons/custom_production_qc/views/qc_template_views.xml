<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_qc_template_list" model="ir.ui.view">
        <field name="name">production.qc.template.list</field>
        <field name="model">production.qc.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="qc_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_qc_template_form" model="ir.ui.view">
        <field name="name">production.qc.template.form</field>
        <field name="model">production.qc.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="qc_type"/>
                            <field name="operation_id"/>
                        </group>

                        <group>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="QC Parameters">
                            <field name="parameter_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="specification"/>
                                    <field name="parameter_type"/>
                                    <field name="uom_id" optional="hide"/>
                                    <field name="min_value" />
                                    <field name="max_value" />
                                    <field name="required"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_qc_template" model="ir.actions.act_window">
        <field name="name">QC Template</field>
        <field name="res_model">production.qc.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>