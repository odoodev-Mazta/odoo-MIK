<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_mou_custom" model="report.paperformat">
        <field name="name">Format Kertas MOU MIK</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_agreement_template" model="ir.actions.report">
        <field name="name">Test Cetak Template MOU</field>
        <field name="model">agreement.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_agreement.report_agreement_template</field>
        <field name="report_file">custom_agreement.report_agreement_template</field>
        <field name="print_report_name">'Test Cetak - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_agreement_template"/>
        <field name="binding_type">report</field>
    </record>
</odoo>