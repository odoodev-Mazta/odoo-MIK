<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mrp_production_dashboard_list" model="ir.ui.view">
        <field name="name">mrp.production.dashboard.list</field>
        <field name="model">mrp.production.dashboard</field>
        <field name="arch" type="xml">
            <list string="Production Dashboard"
                create="0" edit="0" delete="0"
            >
                <field name="mo_name"/>
                <field name="product_id"/>
                <field name="customer_id"/>
                <field name="current_workorder"/>
                <field name="next_workorder"/>
                <field name="workorder_progress"
                       widget="progressbar"/>
                <field name="workorder_status"/>
                <field name="state"/>
                <field name="planned_start"/>
                <field name="planned_end"/>
            </list>
        </field>
    </record>


    <!-- Action untuk membuka list/table -->
    <record id="action_mrp_production_dashboard" model="ir.actions.act_window">
        <field name="name">Production Dashboard List</field>
        <field name="res_model">mrp.production.dashboard</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No production data available.
            </p>
        </field>
    </record>


    <!-- Action untuk dashboard Owl + donut chart -->
    <record id="action_production_dashboard" model="ir.actions.client">
        <field name="name">Production Dashboard</field>
        <field name="tag">production_dashboard</field>
    </record>
</odoo>