<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_delivery_recap_import_wizard" model="ir.ui.view">
        <field name="name">mrp.delivery.recap.import.wizard.form</field>
        <field name="model">mrp.delivery.recap.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Rekapan Surat Jalan">
                <p class="text-muted">
                    Pilih file Excel Rekapan Surat Jalan (satu sheet per bulan). Baris judul diawali kolom "No" dan
                    berisi Nomor SJ, No Batch/ED, Nama Barang, Jumlah Barang, Tanggal Pengiriman, dst.
                    Ini hanya riwayat pengiriman: stok tidak berubah dan Delivery Order tidak dibuat.
                    Import ulang memperbarui data yang sama, bukan mendobel.
                </p>
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_delivery_recap_import" model="ir.actions.act_window">
        <field name="name">Import Rekapan Surat Jalan</field>
        <field name="res_model">mrp.delivery.recap.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_delivery_recap_rematch" model="ir.actions.server">
        <field name="name">Cocokkan Ulang Surat Jalan</field>
        <field name="model_id" ref="model_mrp_delivery_recap"/>
        <field name="state">code</field>
        <field name="code">action = env["mrp.delivery.recap"].action_rematch()</field>
    </record>

    <record id="action_delivery_recap_create_pickings" model="ir.actions.server">
        <field name="name">Buat Delivery Riwayat</field>
        <field name="model_id" ref="model_mrp_delivery_recap"/>
        <field name="state">code</field>
        <field name="code">action = env["mrp.delivery.recap"].action_create_history_pickings()</field>
    </record>

    <record id="view_delivery_recap_list" model="ir.ui.view">
        <field name="name">mrp.delivery.recap.list</field>
        <field name="model">mrp.delivery.recap</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" decoration-warning="match_state == 'pending'"
                  decoration-muted="match_state == 'internal'">
                <header>
                    <button name="%(action_delivery_recap_import)d" type="action" string="Import dari Excel"
                            class="btn-primary" icon="fa-upload" display="always"/>
                    <button name="%(action_delivery_recap_rematch)d" type="action" string="Cocokkan Ulang"
                            icon="fa-refresh" display="always"/>
                    <button name="%(action_delivery_recap_create_pickings)d" type="action"
                            string="Buat Delivery Riwayat" icon="fa-truck" display="always"
                            confirm="Buat Delivery Order berstatus Done di Inventory > Deliveries untuk baris yang sudah terhubung? Stok tidak berubah."/>
                </header>
                <field name="delivery_date"/>
                <field name="sj_number"/>
                <field name="po_number"/>
                <field name="product_name" readonly="1"/>
                <field name="batch_text" optional="show" readonly="1"/>
                <field name="qty" sum="Total Qty" readonly="1"/>
                <field name="unit" optional="hide" readonly="1"/>
                <field name="packing" optional="hide" readonly="1"/>
                <field name="price" optional="hide" readonly="1"/>
                <field name="value" sum="Total Nilai" optional="show" readonly="1"/>
                <field name="expedition" optional="hide" readonly="1"/>
                <field name="recipient" optional="hide" readonly="1"/>
                <field name="brand_id" options="{'no_create': True}" placeholder="Pilih brand terdaftar"/>
                <field name="is_internal" optional="hide"/>
                <field name="sale_order_id" options="{'no_create': True}" optional="show"
                       domain="[('mou_id', '=', mou_id)]"/>
                <field name="mou_id"/>
                <field name="product_tmpl_id" optional="hide" options="{'no_create': True}"/>
                <field name="picking_id" optional="show"/>
                <field name="match_state" widget="badge" decoration-success="match_state == 'matched'"
                       decoration-info="match_state == 'internal'" decoration-warning="match_state == 'pending'"/>
            </list>
        </field>
    </record>

    <record id="view_delivery_recap_form" model="ir.ui.view">
        <field name="name">mrp.delivery.recap.form</field>
        <field name="model">mrp.delivery.recap</field>
        <field name="arch" type="xml">
            <form string="Surat Jalan">
                <sheet>
                    <group>
                        <group>
                            <field name="sj_number"/>
                            <field name="delivery_date"/>
                            <field name="po_number"/>
                            <field name="product_name"/>
                            <field name="batch_text"/>
                            <field name="qty"/>
                            <field name="unit"/>
                            <field name="packing"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="value"/>
                            <field name="expedition"/>
                            <field name="recipient"/>
                            <field name="phone"/>
                            <field name="address"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <group string="Hubungan">
                        <group>
                            <field name="brand_id" options="{'no_create': True}"/>
                            <field name="is_internal"/>
                            <field name="mou_id"/>
                        </group>
                        <group>
                            <field name="sale_order_id" options="{'no_create': True}" domain="[('mou_id', '=', mou_id)]"/>
                            <field name="product_tmpl_id" options="{'no_create': True}"/>
                            <field name="match_state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_delivery_recap_search" model="ir.ui.view">
        <field name="name">mrp.delivery.recap.search</field>
        <field name="model">mrp.delivery.recap</field>
        <field name="arch" type="xml">
            <search string="Rekapan Surat Jalan">
                <field name="sj_number"/>
                <field name="po_number"/>
                <field name="product_name"/>
                <field name="batch_text"/>
                <field name="recipient"/>
                <field name="brand_id"/>
                <field name="proposed_product_name"/>
                <filter name="no_product" string="Produk Baru (belum ada)" domain="[('product_tmpl_id', '=', False)]"/>
                <filter name="has_product" string="Produk Sudah Ada" domain="[('product_tmpl_id', '!=', False)]"/>
                <separator/>
                <filter name="pending" string="Perlu Dipasangkan" domain="[('match_state', '=', 'pending')]"/>
                <filter name="matched" string="Terhubung" domain="[('match_state', '=', 'matched')]"/>
                <filter name="internal" string="Produksi Sendiri" domain="[('match_state', '=', 'internal')]"/>
                <separator/>
                <filter name="delivery_date" string="Tgl Kirim" date="delivery_date"/>
                <group>
                    <filter name="group_proposed" string="Nama Produk Baru" context="{'group_by': 'proposed_product_name'}"/>
                    <filter name="group_brand" string="Brand" context="{'group_by': 'brand_id'}"/>
                    <filter name="group_sj" string="No. Surat Jalan" context="{'group_by': 'sj_number'}"/>
                    <filter name="group_month" string="Bulan Kirim" context="{'group_by': 'delivery_date:month'}"/>
                    <filter name="group_match" string="Status Hubungan" context="{'group_by': 'match_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Pratinjau sebelum Delivery dan produk baru dibuat -->
    <record id="view_delivery_recap_preview_list" model="ir.ui.view">
        <field name="name">mrp.delivery.recap.preview.list</field>
        <field name="model">mrp.delivery.recap</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0" decoration-warning="not product_tmpl_id"
                  decoration-success="product_tmpl_id">
                <header>
                    <button name="%(action_delivery_recap_create_pickings)d" type="action"
                            string="Setujui dan Buat Delivery" class="btn-primary" icon="fa-check" display="always"
                            confirm="Buat Delivery Order riwayat di Inventory > Deliveries, dan buat produk baru untuk baris yang belum punya produk? Stok tidak berubah."/>
                </header>
                <field name="delivery_date" readonly="1"/>
                <field name="sj_number" readonly="1"/>
                <field name="po_number" readonly="1"/>
                <field name="product_name" readonly="1"/>
                <field name="qty" readonly="1" sum="Total Qty"/>
                <field name="product_tmpl_id" options="{'no_create': True}"
                       placeholder="Kosong = produk baru dibuat"/>
                <field name="proposed_product_name" string="Produk Baru Bernama" invisible="product_tmpl_id"/>
                <field name="brand_id" readonly="1"/>
                <field name="mou_id" readonly="1"/>
                <field name="sale_order_id" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="action_delivery_recap_preview" model="ir.actions.act_window">
        <field name="name">Pratinjau Import Surat Jalan</field>
        <field name="res_model">mrp.delivery.recap</field>
        <field name="view_mode">list</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_delivery_recap_preview_list')})]"/>
        <field name="search_view_id" ref="view_delivery_recap_search"/>
        <field name="domain">[('picking_id', '=', False)]</field>
        <field name="context">{'search_default_no_product': 1, 'search_default_group_proposed': 1}</field>
    </record>

    <record id="action_delivery_recap" model="ir.actions.act_window">
        <field name="name">Rekapan Surat Jalan (Excel)</field>
        <field name="res_model">mrp.delivery.recap</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada Rekapan Surat Jalan.</p>
            <p>Klik Import dari Excel di atas daftar untuk memasukkan file Rekapan Surat Jalan.</p>
        </field>
    </record>

    <menuitem id="menu_delivery_recap" active="False" name="Rekapan Surat Jalan (Excel)"
              parent="menu_production_planning_root" action="action_delivery_recap" sequence="53"/>
</odoo>
