<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_production_plan_product_line_form" model="ir.ui.view">
        <field name="name">mrp.production.plan.product.line.form</field>
        <field name="model">mrp.production.plan.product.line</field>
        <field name="arch" type="xml">
            <form string="Production Product">
                <header>
                    <button
                        name="action_open_split_wizard"
                        type="object"
                        string="Partial Production"
                        class="btn-secondary"
                        invisible="
                            parent_product_line_id
                            or remaining_qty &lt;= 0
                        "
                    />
                </header>

                <sheet>
                    <group>
                        <group string="Production">
                            <field name="plan_id"/>
                            <field name="production_number"/>
                            <field name="product_id"/>
                            <field name="product_qty"/>
                            <field name="production_qty" readonly="1"/>
                            <field name="product_uom_id"/>
                            <field name="production_start"/>
                            <field name="production_end"/>
                        </group>

                        <group string="Status">
                            <field name="production_type"/>
                            <field name="parent_product_line_id"/>
                            <field name="child_allocated_qty"/>
                            <field name="remaining_qty"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>

                    <separator string="Operations"/>
                    <field name="operation_line_ids">
                        <list editable="bottom">
                            <field name="sequence"/>
                            <field name="operation_id"/>
                            <field name="workcenter_id"/>
                            <field name="machine_id"/>
                            <field name="capacity_id"/>
                            <field name="capacity_per_day"/>
                            <field name="planned_start" readonly="1"/>
                            <field name="planned_end" readonly="1"/>
                            <field name="state"/>
                        </list>
                    </field>

                    <separator
                        string="Partial Productions"
                        invisible="not child_product_line_ids"
                    />

                    <field name="child_product_line_ids"
                        invisible="not child_product_line_ids">
                        <list>
                            <field name="production_number"/>
                            <field name="product_id"/>
                            <field name="product_qty" string="Total Qty"/>
                            <field name="production_qty" string="Production Qty"/>
                            <field name="production_start"/>
                            <field name="production_end"/>
                            <field name="production_type"/>
                            <field name="progress"/>
                        </list>
                    </field>

                    <separator string="Perintah Produksi"/>
                    <field name="manufacturing_order_ids">
                        <list>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="product_qty"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_production_plan_product_line_stage_form" model="ir.ui.view">
        <field name="name">mrp.production.plan.product.line.stage.form</field>
        <field name="model">mrp.production.plan.product.line</field>
        <field name="arch" type="xml">
            <form string="Atur Tahapan" create="0" delete="0">
                <group>
                    <group>
                        <field name="bom_product_id" string="Produk"/>
                        <field name="production_qty" string="Qty Produksi"/>
                    </group>
                    <group>
                        <field name="production_start"/>
                        <field name="production_end"/>
                    </group>
                </group>
                <field name="stage_ids">
                    <list editable="bottom" create="0" delete="0" decoration-danger="capacity_warning">
                        <field name="sequence" widget="handle"/>
                        <field name="stage_id" readonly="1"/>
                        <field name="date_start" readonly="state == 'done'"/>
                        <field name="date_end" readonly="state == 'done'"/>
                        <field name="pic_ids" string="PIC" widget="many2many_tags" readonly="state == 'done'"
                               options="{'no_create': True}"/>
                        <field name="machine_id" readonly="state == 'done'"
                               options="{'no_quick_create': True}"
                               context="{'default_stage_ids': [(6, 0, [stage_id])]}"
                               domain="['|', ('stage_ids', '=', False), ('stage_ids', 'in', stage_id)]"/>
                        <field name="machine_operator_count" string="Pekerja"/>
                        <field name="capacity_id" readonly="state == 'done' or not machine_id"
                               options="{'no_quick_create': True}"
                               context="{'default_machine_id': machine_id}" placeholder="mis. Tube 20 gr"/>
                        <field name="capacity_per_day" string="Kapasitas/Hari"/>
                        <field name="capacity_qty" readonly="state == 'done' or not capacity_id"/>
                        <field name="days_needed" string="Hari Perlu"/>
                        <field name="days_available" string="Hari Ada"/>
                        <field name="capacity_warning" column_invisible="1"/>
                        <field name="state" widget="badge" decoration-success="state == 'done'"
                               decoration-info="state == 'in_progress'" decoration-warning="state == 'waiting_qc'"/>
                        <field name="qc_state" widget="badge" decoration-success="qc_state == 'passed'"
                               decoration-danger="qc_state == 'failed'"/>
                        <field name="note" optional="hide"/>
                    </list>
                </field>
                <div class="text-muted">
                    Tahap boleh dimulai lebih awal dari jadwal. Tanggal ini hanya rencana.
                </div>
            </form>
        </field>
    </record>

    <record id="view_production_plan_product_line_list" model="ir.ui.view">
        <field name="name">mrp.production.plan.product.line.list</field>
        <field name="model">mrp.production.plan.product.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="production_number"/>
                <field name="product_id"/>
                <field name="product_qty"/>
                <field name="product_uom_id"/>
                <field name="production_start"/>
                <field name="production_end"/>
                <field name="child_allocated_qty"/>
                <field name="remaining_qty"/>
                <field name="production_type"/>
                <field name="progress" widget="progressbar"/>

                <button
                    name="action_open_split_wizard"
                    type="object"
                    string="Partial Production"
                    icon="fa-code-fork"
                    invisible="parent_product_line_id or remaining_qty &lt;= 0"/>
            </list>
        </field>
    </record>

</odoo>