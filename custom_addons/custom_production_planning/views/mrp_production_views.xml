<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_mrp_production_form_inherit_plan" model="ir.ui.view">
        <field name="name">mrp.production.form.production.plan</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']"
                   position="inside">
                <button
                    name="action_open_production_plan"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-calendar">

                    <field
                        name="production_plan_id"
                        widget="statinfo"
                        string="Production Plan"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='product_id']" position="after">
                <field name="production_plan_id"/>
                <field name="plan_mou_id" invisible="not production_plan_id"/>
                <field name="plan_brand_name" invisible="not production_plan_id"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Produk Lain di Plan" invisible="not plan_sibling_mo_ids">
                    <field name="plan_sibling_mo_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="product_qty"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <!-- Proses Produksi ditaruh sebelum Work Orders (tombol jalan ada di sini). -->
            <xpath expr="//page[@name='operations']" position="before">
                <page string="Proses Produksi" invisible="not stage_ids">
                    <field name="stage_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sequence" widget="handle"/>
                            <field name="stage_id" readonly="1"/>
                            <field name="date_start" readonly="1"/>
                            <field name="date_end" readonly="1"/>
                            <field name="pic_ids" widget="many2many_tags" readonly="state == 'done'" string="PIC"
                                   options="{'no_create': True}"/>
                            <field name="started_by_id" optional="show"/>
                            <field name="date_start_actual" optional="hide"/>
                            <field name="qc_submit_date" string="Mulai QC" optional="show"/>
                            <field name="qc_user_id" string="Approve QC" optional="show"/>
                            <field name="qc_date" string="Selesai QC" optional="show"/>
                            <field name="machine_id" readonly="1" optional="hide"/>
                            <field name="qty_good" readonly="state != 'waiting_qc'"/>
                            <field name="qty_reject" readonly="state != 'waiting_qc'"/>
                            <field name="set_batch" column_invisible="1"/>
                            <field name="batch_no" readonly="not set_batch or state != 'in_progress'"/>
                            <field name="expiry_date" readonly="not set_batch or state != 'in_progress'"/>
                            <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'in_progress'" decoration-warning="state == 'waiting_qc'"/>
                            <field name="qc_state" widget="badge" decoration-success="qc_state == 'passed'" decoration-danger="qc_state == 'failed'"/>
                            <field name="qc_note" readonly="state != 'waiting_qc'" placeholder="Wajib diisi bila QC Gagal"/>
                            <field name="has_checks" column_invisible="1"/>
                            <button name="action_start" type="object" string="Mulai" icon="fa-play"
                                    invisible="state != 'todo'"/>
                            <button name="action_submit_qc" type="object" string="Ajukan QC" icon="fa-paper-plane"
                                    invisible="state != 'in_progress'"/>
                            <button name="action_open_checks" type="object" string="Isi Parameter QC" icon="fa-list-alt"
                                    invisible="state != 'waiting_qc' or not has_checks"
                                    groups="custom_production_planning.group_production_qc,base.group_system"/>
                            <button name="action_qc_pass" type="object" string="QC Lulus" icon="fa-check"
                                    invisible="state != 'waiting_qc'"
                                    groups="custom_production_planning.group_production_qc,base.group_system"/>
                            <button name="action_qc_fail" type="object" string="QC Gagal" icon="fa-times"
                                    invisible="state != 'waiting_qc'"
                                    groups="custom_production_planning.group_production_qc,base.group_system"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Kolom Quantity di tab Work Orders = sisa. Tambah kolom "Sudah Dikerjakan" supaya jelas. -->
    <record id="view_mrp_workorder_list_mo_form_qty" model="ir.ui.view">
        <field name="name">mrp.workorder.list.mo.form.qty</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view_mo_form"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='qty_remaining']" position="attributes">
                <attribute name="string">Sisa Qty</attribute>
            </xpath>
            <xpath expr="//list/field[@name='qty_remaining']" position="before">
                <field name="qty_produced" string="Sudah Dikerjakan" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Tab Work Orders (sempat disembunyikan). -->
    <record id="view_mrp_production_form_hide_workorders" model="ir.ui.view">
        <field name="name">mrp.production.form.hide.workorders</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='operations']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
        </field>
    </record>

    <!-- Work Order yang sudah Done tetap tampil di daftar / kalender / Gantt (jadwal dan realisasinya tetap terlihat). -->
    <record id="mrp.action_work_orders" model="ir.actions.act_window">
        <field name="domain">[('state', '!=', 'cancel')]</field>
    </record>
    <record id="mrp.action_mrp_workorder_workcenter" model="ir.actions.act_window">
        <field name="context">{'search_default_work_center': True, 'show_workcenter_status': True}</field>
    </record>
    <record id="mrp.action_mrp_workorder_production" model="ir.actions.act_window">
        <field name="domain">[('production_state', '!=', 'cancel')]</field>
        <field name="context">{'search_default_production': True}</field>
    </record>
    <record id="mrp.mrp_workorder_todo" model="ir.actions.act_window">
        <field name="context">{}</field>
    </record>
</odoo>
