<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_mrp_production_form_inherit_plan" model="ir.ui.view">
        <field name="name">mrp.production.form.production.plan</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']"
                   position="inside">
                <button
                    name="action_open_production_plan"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-calendar">

                    <field
                        name="production_plan_id"
                        widget="statinfo"
                        string="Production Plan"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='product_id']" position="after">
                <field name="production_plan_id"/>
            </xpath>
        </field>
    </record>

</odoo>