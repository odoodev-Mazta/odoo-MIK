<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_mrp_production_form_inherit_plan" model="ir.ui.view">
        <field name="name">mrp.production.form.production.plan</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']"
                   position="inside">
                <button
                    name="action_open_production_plan"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-calendar">

                    <field
                        name="production_plan_id"
                        widget="statinfo"
                        string="Production Plan"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='product_id']" position="after">
                <field name="production_plan_id"/>
                <field name="plan_mou_id" invisible="not production_plan_id"/>
                <field name="plan_brand_name" invisible="not production_plan_id"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Proses Produksi" invisible="not stage_ids">
                    <field name="stage_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sequence" widget="handle"/>
                            <field name="stage_id" readonly="1"/>
                            <field name="date_start" readonly="1"/>
                            <field name="date_end" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="machine_id" readonly="1" optional="hide"/>
                            <field name="qty_good" readonly="state != 'in_progress'"/>
                            <field name="qty_reject" readonly="state != 'in_progress'"/>
                            <field name="set_batch" column_invisible="1"/>
                            <field name="batch_no" readonly="not set_batch or state != 'in_progress'"/>
                            <field name="expiry_date" readonly="not set_batch or state != 'in_progress'"/>
                            <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'in_progress'"/>
                            <field name="qc_state" widget="badge" decoration-success="qc_state == 'passed'" decoration-danger="qc_state == 'failed'"/>
                            <field name="qc_note" readonly="state != 'in_progress'"/>
                            <field name="has_checks" column_invisible="1"/>
                            <button name="action_start" type="object" string="Mulai" icon="fa-play"
                                    invisible="state != 'todo'"/>
                            <button name="action_open_checks" type="object" string="Isi Parameter QC" icon="fa-list-alt"
                                    invisible="state != 'in_progress' or not has_checks"/>
                            <button name="action_qc_pass" type="object" string="QC Lulus" icon="fa-check"
                                    invisible="state != 'in_progress' or qc_state == 'passed'"/>
                            <button name="action_qc_fail" type="object" string="QC Gagal" icon="fa-times"
                                    invisible="state != 'in_progress' or qc_state == 'passed'"/>
                            <button name="action_done" type="object" string="Selesai" icon="fa-flag-checkered"
                                    invisible="state != 'in_progress' or qc_state != 'passed'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>