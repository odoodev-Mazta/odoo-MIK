<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form_send_to_plan" model="ir.ui.view">
        <field name="name">sale.order.form.send.to.plan</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_to_plan_production" string="Send to Plan Production"
                        type="object" class="btn-primary" invisible="state != 'sale'"/>
            </xpath>
        </field>
    </record>
</odoo>
