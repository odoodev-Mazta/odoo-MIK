<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_production_qc_log_list" model="ir.ui.view">
        <field name="name">mrp.production.qc.log.list</field>
        <field name="model">mrp.production.qc.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-success="result == 'passed'" decoration-danger="result == 'failed'">
                <field name="qc_date"/>
                <field name="plan_id"/>
                <field name="production_id" optional="show"/>
                <field name="product_id"/>
                <field name="stage_id"/>
                <field name="batch_no" optional="hide"/>
                <field name="attempt" optional="show"/>
                <field name="started_by_id" optional="show"/>
                <field name="submitted_by_id" optional="hide"/>
                <field name="qc_user_id"/>
                <field name="qty_good" sum="Total Bagus" optional="show"/>
                <field name="qty_reject" sum="Total Reject" optional="hide"/>
                <field name="failed_parameters" optional="show"/>
                <field name="reason"/>
                <field name="result" widget="badge"
                       decoration-success="result == 'passed'" decoration-danger="result == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_production_qc_log_form" model="ir.ui.view">
        <field name="name">mrp.production.qc.log.form</field>
        <field name="model">mrp.production.qc.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h2><field name="display_name"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="result" widget="badge"
                                   decoration-success="result == 'passed'" decoration-danger="result == 'failed'"/>
                            <field name="plan_id"/>
                            <field name="production_id"/>
                            <field name="product_id"/>
                            <field name="stage_id"/>
                            <field name="plan_stage_id"/>
                            <field name="batch_no"/>
                            <field name="attempt"/>
                        </group>
                        <group>
                            <field name="started_by_id"/>
                            <field name="submitted_by_id"/>
                            <field name="submit_date"/>
                            <field name="qc_user_id"/>
                            <field name="qc_date"/>
                            <field name="qty_good"/>
                            <field name="qty_reject"/>
                        </group>
                    </group>
                    <group>
                        <field name="failed_parameters"/>
                        <field name="reason"/>
                    </group>
                    <separator string="Hasil Parameter"/>
                    <field name="line_ids">
                        <list decoration-success="result == 'passed'" decoration-danger="result == 'failed'">
                            <field name="name"/>
                            <field name="specification"/>
                            <field name="unit"/>
                            <field name="min_value"/>
                            <field name="max_value"/>
                            <field name="actual"/>
                            <field name="result" widget="badge"
                                   decoration-success="result == 'passed'" decoration-danger="result == 'failed'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_production_qc_log_search" model="ir.ui.view">
        <field name="name">mrp.production.qc.log.search</field>
        <field name="model">mrp.production.qc.log</field>
        <field name="arch" type="xml">
            <search string="Laporan QC">
                <field name="plan_id"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="stage_id"/>
                <field name="qc_user_id"/>
                <field name="started_by_id"/>
                <field name="batch_no"/>
                <field name="reason"/>
                <filter name="passed" string="Lulus" domain="[('result', '=', 'passed')]"/>
                <filter name="failed" string="Gagal" domain="[('result', '=', 'failed')]"/>
                <separator/>
                <filter name="qc_date" string="Tanggal QC" date="qc_date"/>
                <group>
                    <filter name="group_result" string="Hasil" context="{'group_by': 'result'}"/>
                    <filter name="group_stage" string="Tahap" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_product" string="Produk" context="{'group_by': 'product_id'}"/>
                    <filter name="group_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
                    <filter name="group_qc_user" string="Diperiksa Oleh" context="{'group_by': 'qc_user_id'}"/>
                    <filter name="group_started" string="Dikerjakan Oleh" context="{'group_by': 'started_by_id'}"/>
                    <filter name="group_month" string="Bulan" context="{'group_by': 'qc_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_production_qc_log_pivot" model="ir.ui.view">
        <field name="name">mrp.production.qc.log.pivot</field>
        <field name="model">mrp.production.qc.log</field>
        <field name="arch" type="xml">
            <pivot string="Laporan QC">
                <field name="stage_id" type="row"/>
                <field name="result" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_production_qc_log" model="ir.actions.act_window">
        <field name="name">Laporan QC</field>
        <field name="res_model">mrp.production.qc.log</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="search_view_id" ref="view_production_qc_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada QC yang dijalankan</p>
            <p>Setiap kali QC menyatakan Lulus atau Gagal di tahap produksi, hasilnya tercatat di sini.</p>
        </field>
    </record>

    <menuitem
        id="menu_production_qc_log"
        name="Laporan QC"
        parent="menu_production_planning_root"
        action="action_production_qc_log"
        sequence="46"
    />
</odoo>
