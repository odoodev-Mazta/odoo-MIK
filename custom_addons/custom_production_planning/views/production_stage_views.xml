<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_production_stage_list" model="ir.ui.view">
        <field name="name">mrp.production.stage.list</field>
        <field name="model">mrp.production.stage</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="origin_type"/>
                <field name="set_batch"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_production_stage_form" model="ir.ui.view">
        <field name="name">mrp.production.stage.form</field>
        <field name="model">mrp.production.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="origin_type"/>
                        <field name="set_batch"/>
                    </group>
                    <separator string="Parameter QC tahap ini"/>
                    <field name="parameter_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="parameter_type"/>
                            <field name="specification"/>
                            <field name="unit"/>
                            <field name="min_value"/>
                            <field name="max_value"/>
                            <field name="required"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_production_plan_stage_form" model="ir.ui.view">
        <field name="name">mrp.production.plan.stage.form</field>
        <field name="model">mrp.production.plan.stage</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_qc_pass" type="object" string="Selesaikan QC" class="btn-primary"
                            invisible="state != 'in_progress' or qc_state == 'passed'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="stage_id" readonly="1"/>
                            <field name="product_id"/>
                            <field name="state" widget="badge"/>
                        </group>
                        <group>
                            <field name="qty_good" readonly="state != 'in_progress'"/>
                            <field name="qc_state" widget="badge" decoration-success="qc_state == 'passed'" decoration-danger="qc_state == 'failed'"/>
                            <field name="qc_note"/>
                        </group>
                    </group>
                    <separator string="Pemeriksaan"/>
                    <field name="check_ids" readonly="state != 'in_progress'">
                        <list editable="bottom" create="0" delete="0">
                            <field name="parameter_type" column_invisible="1"/>
                            <field name="name" readonly="1"/>
                            <field name="specification" readonly="1"/>
                            <field name="unit" readonly="1"/>
                            <field name="min_value" readonly="1" optional="show"/>
                            <field name="max_value" readonly="1" optional="show"/>
                            <field name="actual_value" readonly="parameter_type == 'boolean'"/>
                            <field name="actual_yesno" readonly="parameter_type != 'boolean'"/>
                            <field name="result" widget="badge" decoration-success="result == 'passed'" decoration-danger="result == 'failed'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_production_stage" model="ir.actions.act_window">
        <field name="name">Tahap Proses</field>
        <field name="res_model">mrp.production.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_production_stage"
        name="Tahap Proses"
        parent="menu_production_planning_root"
        action="action_production_stage"
        sequence="40"
    />
</odoo>
