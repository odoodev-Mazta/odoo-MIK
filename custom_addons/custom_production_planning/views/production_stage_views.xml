<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_production_stage_list" model="ir.ui.view">
        <field name="name">mrp.production.stage.list</field>
        <field name="model">mrp.production.stage</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="origin_type"/>
                <field name="set_batch"/>
                <field name="use_machine"/>
                <field name="workcenter_id"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_production_stage_form" model="ir.ui.view">
        <field name="name">mrp.production.stage.form</field>
        <field name="model">mrp.production.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="origin_type"/>
                        <field name="set_batch"/>
                        <field name="use_machine"/>
                        <field name="workcenter_id"/>
                    </group>
                    <separator string="Parameter QC tahap ini"/>
                    <field name="parameter_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="parameter_type"/>
                            <field name="specification"/>
                            <field name="unit"/>
                            <field name="min_value"/>
                            <field name="max_value"/>
                            <field name="required"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_production_plan_stage_form" model="ir.ui.view">
        <field name="name">mrp.production.plan.stage.form</field>
        <field name="model">mrp.production.plan.stage</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_qc_pass" type="object" string="QC Lulus" class="btn-primary"
                            invisible="state != 'waiting_qc'"
                            groups="custom_production_planning.group_production_qc,base.group_system"/>
                    <button name="action_qc_fail" type="object" string="QC Gagal"
                            invisible="state != 'waiting_qc'"
                            groups="custom_production_planning.group_production_qc,base.group_system"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="stage_id" readonly="1"/>
                            <field name="product_id"/>
                            <field name="state" widget="badge"/>
                        </group>
                        <group>
                            <field name="qty_good" readonly="1"/>
                            <field name="qc_state" widget="badge" decoration-success="qc_state == 'passed'" decoration-danger="qc_state == 'failed'"/>
                            <field name="qc_note" readonly="state != 'waiting_qc'"/>
                        </group>
                    </group>
                    <group string="Riwayat Proses">
                        <group>
                            <field name="pic_ids" widget="many2many_tags" readonly="1" string="PIC"/>
                            <field name="started_by_id"/>
                            <field name="date_start_actual"/>
                            <field name="submitted_by_id"/>
                            <field name="qc_submit_date"/>
                        </group>
                        <group>
                            <field name="qc_user_id" string="Diperiksa / Approve QC"/>
                            <field name="qc_date"/>
                            <field name="date_end_actual"/>
                            <field name="qc_attempt"/>
                        </group>
                    </group>
                    <separator string="Pemeriksaan"/>
                    <div class="text-muted" invisible="state != 'waiting_qc'">
                        Minimum, Maksimum, dan Spesifikasi boleh diubah khusus untuk produksi ini.
                        Data di QC Template / QC Parameter tidak ikut berubah; perubahan dicatat di chatter Plan.
                    </div>
                    <field name="check_ids" readonly="state != 'waiting_qc'">
                        <list editable="bottom" delete="0">
                            <field name="parameter_type" optional="hide"/>
                            <field name="name"/>
                            <field name="specification"/>
                            <field name="unit"/>
                            <field name="min_value" readonly="parameter_type != 'number'" optional="show"/>
                            <field name="max_value" readonly="parameter_type != 'number'" optional="show"/>
                            <field name="actual_value" readonly="parameter_type == 'boolean'"/>
                            <field name="actual_yesno" readonly="parameter_type != 'boolean'"/>
                            <field name="result" widget="badge" decoration-success="result == 'passed'" decoration-danger="result == 'failed'"/>
                        </list>
                    </field>
                    <separator string="Riwayat QC" invisible="not qc_log_ids"/>
                    <field name="qc_log_ids" readonly="1" invisible="not qc_log_ids">
                        <list decoration-success="result == 'passed'" decoration-danger="result == 'failed'">
                            <field name="attempt"/>
                            <field name="qc_date"/>
                            <field name="started_by_id"/>
                            <field name="qc_user_id"/>
                            <field name="failed_parameters"/>
                            <field name="reason"/>
                            <field name="result" widget="badge"
                                   decoration-success="result == 'passed'" decoration-danger="result == 'failed'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_production_plan_stage_qc_list" model="ir.ui.view">
        <field name="name">mrp.production.plan.stage.qc.list</field>
        <field name="model">mrp.production.plan.stage</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="qc_submit_date" string="Diajukan"/>
                <field name="plan_id"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="batch_label"/>
                <field name="stage_id"/>
                <field name="qty_good"/>
                <field name="state" widget="badge" decoration-warning="state == 'waiting_qc'"
                       decoration-success="state == 'done'"/>
                <field name="qc_state" widget="badge" decoration-success="qc_state == 'passed'"
                       decoration-danger="qc_state == 'failed'"/>
                <button name="action_open_checks" type="object" string="Periksa" icon="fa-list-alt"
                        invisible="state != 'waiting_qc'"/>
            </list>
        </field>
    </record>

    <record id="action_production_qc_queue" model="ir.actions.act_window">
        <field name="name">Antrean QC</field>
        <field name="res_model">mrp.production.plan.stage</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_production_plan_stage_qc_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_production_plan_stage_form')})]"/>
        <field name="domain">[('state', '=', 'waiting_qc')]</field>
    </record>

    <record id="view_production_plan_stage_history_list" model="ir.ui.view">
        <field name="name">mrp.production.plan.stage.history.list</field>
        <field name="model">mrp.production.plan.stage</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0"
                  decoration-success="state == 'done'" decoration-info="state == 'in_progress'"
                  decoration-warning="state == 'waiting_qc'">
                <field name="plan_id"/>
                <field name="production_id" optional="show"/>
                <field name="product_id"/>
                <field name="batch_label" optional="hide"/>
                <field name="stage_id"/>
                <field name="pic_ids" widget="many2many_tags" string="PIC"/>
                <field name="started_by_id"/>
                <field name="date_start_actual"/>
                <field name="submitted_by_id" optional="show"/>
                <field name="qc_submit_date" optional="hide"/>
                <field name="qc_user_id" string="Approve QC"/>
                <field name="qc_date" optional="show"/>
                <field name="date_end_actual" optional="hide"/>
                <field name="qty_good" sum="Total Bagus"/>
                <field name="qty_reject" sum="Total Reject"/>
                <field name="batch_no" optional="hide"/>
                <field name="qc_attempt" optional="hide"/>
                <field name="qc_note" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-info="state == 'in_progress'" decoration-warning="state == 'waiting_qc'"/>
                <field name="qc_state" widget="badge" decoration-success="qc_state == 'passed'"
                       decoration-danger="qc_state == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_production_plan_stage_history_search" model="ir.ui.view">
        <field name="name">mrp.production.plan.stage.history.search</field>
        <field name="model">mrp.production.plan.stage</field>
        <field name="arch" type="xml">
            <search string="Riwayat Proses Produksi">
                <field name="plan_id"/>
                <field name="product_id"/>
                <field name="stage_id"/>
                <field name="started_by_id"/>
                <field name="qc_user_id"/>
                <field name="batch_no"/>
                <filter name="done" string="Selesai" domain="[('state', '=', 'done')]"/>
                <filter name="running" string="Berjalan" domain="[('state', '=', 'in_progress')]"/>
                <filter name="waiting_qc" string="Menunggu QC" domain="[('state', '=', 'waiting_qc')]"/>
                <separator/>
                <filter name="qc_failed_once" string="Pernah Gagal QC" domain="[('qc_attempt', '>', 1)]"/>
                <separator/>
                <filter name="date_start_actual" string="Tanggal Mulai" date="date_start_actual"/>
                <group>
                    <filter name="group_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
                    <filter name="group_product" string="Produk" context="{'group_by': 'product_id'}"/>
                    <filter name="group_stage" string="Tahap" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_started" string="Dimulai Oleh" context="{'group_by': 'started_by_id'}"/>
                    <filter name="group_qc" string="Approve QC" context="{'group_by': 'qc_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_production_stage_history" model="ir.actions.act_window">
        <field name="name">Riwayat Proses Produksi</field>
        <field name="res_model">mrp.production.plan.stage</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_production_plan_stage_history_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_production_plan_stage_form')})]"/>
        <field name="search_view_id" ref="view_production_plan_stage_history_search"/>
        <field name="domain">[('state', '!=', 'todo')]</field>
        <field name="context">{'search_default_group_plan': 1}</field>
    </record>

    <menuitem
        id="menu_production_stage_history"
        name="Riwayat Proses Produksi"
        parent="menu_production_planning_root"
        action="action_production_stage_history"
        sequence="47"
    />

    <record id="action_production_stage" model="ir.actions.act_window">
        <field name="name">Tahap Proses</field>
        <field name="res_model">mrp.production.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_production_stage"
        name="Tahap Proses"
        parent="menu_production_planning_root"
        action="action_production_stage"
        sequence="40"
    />

    <menuitem
        id="menu_production_qc_queue"
        name="Antrean QC"
        parent="menu_production_planning_root"
        action="action_production_qc_queue"
        sequence="45"
        groups="custom_production_planning.group_production_qc,base.group_system"
    />
</odoo>
