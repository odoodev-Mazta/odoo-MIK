<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_production_plan_list" model="ir.ui.view">
        <field name="name">mrp.production.plan.list</field>
        <field name="model">mrp.production.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="mou_id" optional="show"/>
                <field name="brand_name" optional="show"/>
                <field name="origin_type"/>
                <field name="production_po_number"/>
                <field name="customer_id"/>
                <field name="planned_start"/>
                <field name="planned_end"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_production_plan_form" model="ir.ui.view">
        <field name="name">mrp.production.plan.form</field>
        <field name="model">mrp.production.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_generate_stages"
                        type="object"
                        string="Buat Jadwal Proses"
                        class="btn-primary"
                        invisible="state != 'draft' or material_check_state != 'available'"
                    />

                    <button
                        name="action_check_capacity"
                        type="object"
                        string="Check Capacity"
                        class="btn-secondary"
                        invisible="state in ('done', 'cancel') or stage_ids"
                    />

                    <button
                        name="action_approve"
                        type="object"
                        string="Approve Planning"
                        class="btn-primary"
                        invisible="state != 'planned'"
                    />

                    <button
                        name="action_create_mo"
                        type="object"
                        string="Buat Perintah Produksi"
                        class="btn-primary"
                        invisible="state not in ('approved', 'running') or not has_pending_mo"
                    />

                    <button
                        name="action_load_operations"
                        type="object"
                        string="Load Operations"
                        class="btn-secondary"
                        invisible="state != 'draft' or stage_ids"
                    />

                    <button
                        name="action_reschedule"
                        type="object"
                        string="Reschedule"
                        class="btn-secondary"
                        invisible="state not in ('planned','approved','running')"
                    />

                    <button
                        name="action_check_machine_availability"
                        type="object"
                        string="Check Machine Availability"
                        class="btn-info"
                        invisible="state != 'draft' or stage_ids"
                    />

                    <button
                        name="action_reset_planning"
                        type="object"
                        string="Reset Planning"
                        invisible="state not in ('planned','approved')"
                    />

                    <button
                        name="action_validate_planning"
                        type="object"
                        string="Validate Planning"
                        class="btn-info"
                        invisible="state != 'planned'"
                    />

                    <button
                        name="action_check_material"
                        type="object"
                        string="Check Material Availability"
                        class="btn-info"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,planned,approved,running,done"
                    />
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">

                    </div>

                    <group>
                        <group>
                            <field name="name" readonly="state != 'draft'" placeholder="Kosongkan untuk nomor otomatis"/>
                            <field name="sale_order_id"/>
                            <field name="origin_type" readonly="state != 'draft'"/>
                            <field name="mou_id"/>
                            <field name="brand_name"/>
                            <field name="purchase_order_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field
                                name="production_type"
                                widget="badge"
                            />
                            <field
                                name="has_pending_mo"
                                string="Belum Dibuat Perintah Produksi"
                            />
                            <field name="customer_id"/>
                            <field
                                name="is_child_plan"
                                invisible="1"
                            />

                            <field
                                name="has_child_production"
                                invisible="1"
                            />

                            <div
                                class="alert alert-info"
                                role="alert"
                                invisible="not is_child_plan"
                            >
                                <strong>Partial Production</strong>
                            </div>

                            <div
                                class="alert alert-warning"
                                role="alert"
                                invisible="not has_child_production"
                            >
                                <strong>Production sudah di-split</strong>
                            </div>
                        </group>

<!--                        <group>-->
<!--                            <field name="product_id"/>-->
<!--                            <field name="product_qty"/>-->
<!--                            <field name="product_uom_id"/>-->
<!--                        </group>-->
                    </group>

                    <group string="Planning Period">
                        <field name="planned_start" string="Planning Start"/>
                        <field name="planned_end" string="Planning End"/>
                        <field name="progress" widget="progressbar"/>
                    </group>

                    <group>
                        <field name="note"/>
                    </group>

                    <notebook>
                        <page string="Products">
                            <field name="product_line_ids">
                                <list editable="bottom">
                                    <field name="product_id" width="300px"/>
                                    <field name="finished_product_id" width="300px"
                                           options="{'no_create': True}"/>
                                    <field name="product_qty" string="Qty" width="110px"/>
                                    <field name="production_qty" string="Qty Produksi" readonly="1" width="130px"/>
                                    <field name="product_uom_id" optional="hide"/>
                                    <field name="production_start" string="Mulai" optional="hide"/>
                                    <field name="production_end" string="Selesai" optional="hide"/>
                                    <field name="child_allocated_qty" string="Dipecah" optional="hide"/>
                                    <field name="remaining_qty" string="Sisa Split" optional="hide"/>
                                    <field name="production_type" string="Tipe" optional="hide"/>

                                    <field name="create_mo" string="Buat Perintah" width="130px"/>
                                    <field name="has_mo" string="Sudah Dibuat" readonly="1" optional="hide"/>
                                    <field name="progress" widget="progressbar" width="120px"/>

                                    <button
                                        name="action_view_child_productions"
                                        type="object"
                                        title="Lihat hasil pecahan produksi"
                                        icon="fa-code-fork"
                                        invisible="not child_product_line_ids"
                                    />
                                    <button
                                        name="action_open_split_wizard"
                                        type="object"
                                        title="Pecah produksi (Split)"
                                        icon="fa-scissors"
                                        invisible="parent_product_line_id or remaining_qty &lt;= 0"
                                    />
                                </list>
                            </field>
                        </page>

                        <page string="Jadwal Proses">
                            <field name="stage_ids" readonly="state in ('done', 'cancel')">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="stage_id" readonly="1"/>
                                    <field name="date_start" readonly="state == 'done'"/>
                                    <field name="date_end" readonly="state == 'done'"/>
                                    <field name="user_id" readonly="state == 'done'"/>
                                    <field name="machine_id" readonly="state == 'done'"/>
                                    <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'in_progress'"/>
                                    <field name="qc_state" widget="badge" decoration-success="qc_state == 'passed'" decoration-danger="qc_state == 'failed'"/>
                                    <field name="qty_good" readonly="1" optional="hide"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                            <div class="text-muted">
                                Tahap dikerjakan (Mulai, isi qty, QC, Selesai) dari tab Proses Produksi
                                di Perintah Produksi tiap produk.
                            </div>
                        </page>

                        <page string="Operations" invisible="stage_ids">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field
                                        name="product_id"
                                        readonly="1"
                                    />

                                    <field
                                        name="operation_id"
                                        readonly="1"
                                    />

                                    <field
                                        name="workcenter_id"
                                        readonly="1"
                                    />

                                    <field name="machine_id"/>
                                    <field name="capacity_id"/>
                                    <field
                                        name="capacity_warning"
                                        decoration-danger="capacity_warning"
                                    />
                                    <field name="workorder_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <page string="Material Availability">
                            <field name="material_shortage_ids" readonly="1">
                                <list>
                                    <field
                                        name="product_line_id"
                                        string="Production Product"
                                    />
                                    <field
                                        name="product_id"
                                        string="Material"
                                    />
                                    <field name="required_qty"/>
                                    <field name="available_qty"/>
                                    <field name="shortage_qty"/>
                                </list>
                            </field>
                        </page>

                        <page string="Machine Schedule" invisible="stage_ids">
                            <field
                                name="machine_schedule_ids"
                                readonly="1"
                            >
                                <list>
                                    <field name="product_id" string="Product"/>
                                    <field name="operation_id"/>
                                    <field name="machine_id"/>
                                    <field name="workorder_id"/>
                                    <field name="capacity_id"/>
                                    <field name="planned_qty"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <page string="Perintah Produksi">
                            <field name="manufacturing_order_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>


<!--                        <page-->
<!--                            string="Partial Production"-->
<!--                            invisible="parent_plan_id"-->
<!--                        >-->
<!--                            <field name="child_plan_ids">-->
<!--                                <list>-->
<!--                                    <field name="production_number"/>-->
<!--                                    <field name="production_po_number"/>-->
<!--                                    <field name="product_id"/>-->
<!--                                    <field name="product_qty"/>-->
<!--                                    <field name="planned_start"/>-->
<!--                                    <field name="planned_end"/>-->
<!--                                    <field name="state"/>-->
<!--                                </list>-->
<!--                            </field>-->
<!--                        </page>-->
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_production_plan" model="ir.actions.act_window">
        <field name="name">Production Planning</field>
        <field name="res_model">mrp.production.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>