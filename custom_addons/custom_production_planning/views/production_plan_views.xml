<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_production_plan_list" model="ir.ui.view">
        <field name="name">mrp.production.plan.list</field>
        <field name="model">mrp.production.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="customer_id"/>
                <field name="planned_start"/>
                <field name="planned_end"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_production_plan_form" model="ir.ui.view">
        <field name="name">mrp.production.plan.form</field>
        <field name="model">mrp.production.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_check_capacity"
                        type="object"
                        string="Check Capacity"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />

                    <button
                        name="action_approve"
                        type="object"
                        string="Approve Planning"
                        class="btn-primary"
                        invisible="state != 'planned'"
                    />

                    <button
                        name="action_create_mo"
                        type="object"
                        string="Create MO"
                        class="btn-success"
                        invisible="state != 'approved'"
                    />

                    <button name="action_load_operations" type="object"
                        string="Load Operations" class="btn-secondary"
                        invisible="state != 'draft'"
                    />

                    <button name="action_reschedule" type="object"
                        string="Reschedule" class="btn-secondary"
                        invisible="state not in ('planned','approved')"
                    />

                    <button name="action_check_machine_availability" type="object"
                        string="Check Machine Availability" class="btn-info"
                        invisible="state != 'draft'"
                    />

                    <button name="action_reset_planning" type="object"
                        string="Reset Planning" invisible="state not in ('planned','approved')"
                    />

                    <button name="action_validate_planning" type="object"
                        string="Validate Planning" class="btn-info"
                        invisible="state != 'planned'"
                    />

                    <button name="action_check_material" type="object"
                            string="Check Material Availability" class="btn-info"
                        />

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,planned,approved,running,done"
                    />
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sale_order_id"/>
                            <field name="customer_id"/>
                        </group>

                        <group>
                            <field name="product_id"/>
                            <field name="product_qty"/>
                            <field name="product_uom_id"/>
                        </group>

                        <group>
                            <field name="planned_start"/>
                            <field name="planned_end"/>
                            <field name="progress"
                                   widget="progressbar"/>
                        </group>
                    </group>

                    <group>
                        <field name="note"/>
                    </group>

                    <notebook>
                        <page string="Operations">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="operation_id" readonly="1"/>
                                    <field name="workcenter_id" readonly="1"/>
                                    <field name="machine_id"/>
                                    <field name="capacity_id"/>
                                    <field name="capacity_warning"
                                           decoration-danger="capacity_warning"/>
                                    <field name="workorder_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Material Availability">
                            <field name="material_shortage_ids" readonly="1">
                                <list>
                                    <field name="product_id"/>
                                    <field name="required_qty"/>
                                    <field name="available_qty"/>
                                    <field name="shortage_qty"/>
                                </list>
                            </field>
                        </page>
                        <page string="Machine Schedule">
                            <field name="machine_schedule_ids" readonly="1">
                                <list>
                                    <field name="operation_id"/>
                                    <field name="machine_id"/>
                                    <field name="workorder_id"/>
                                    <field name="product_id"/>
                                    <field name="capacity_id"/>
                                    <field name="planned_qty"/>
                                    <field name="planned_start"/>
                                    <field name="planned_end"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Manufacturing Orders">
                            <field name="manufacturing_order_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_production_plan" model="ir.actions.act_window">
        <field name="name">Production Planning</field>
        <field name="res_model">mrp.production.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>