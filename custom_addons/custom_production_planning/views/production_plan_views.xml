<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_production_plan_list" model="ir.ui.view">
        <field name="name">mrp.production.plan.list</field>
        <field name="model">mrp.production.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="mou_id" optional="show"/>
                <field name="brand_name" optional="show"/>
                <field name="origin_type"/>
                <field name="production_po_number"/>
                <field name="customer_id"/>
                <field name="planned_start"/>
                <field name="planned_end"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_production_plan_form" model="ir.ui.view">
        <field name="name">mrp.production.plan.form</field>
        <field name="model">mrp.production.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_generate_stages"
                        type="object"
                        string="Buat Jadwal Proses"
                        class="btn-primary"
                        invisible="state != 'draft' or not material_checked"
                    />

                    <button
                        name="action_check_capacity"
                        type="object"
                        string="Check Capacity"
                        class="btn-secondary"
                        invisible="1"
                    />

                    <button
                        name="action_approve"
                        type="object"
                        string="Approve Planning"
                        class="btn-primary"
                        invisible="state != 'planned'"
                    />

                    <button
                        name="action_create_mo"
                        type="object"
                        string="Buat Perintah Produksi"
                        class="btn-primary"
                        invisible="state not in ('approved', 'running') or not has_pending_mo"
                    />

                    <button
                        name="action_load_operations"
                        type="object"
                        string="Load Operations"
                        class="btn-secondary"
                        invisible="1"
                    />

                    <button
                        name="action_reschedule"
                        type="object"
                        string="Reschedule"
                        class="btn-secondary"
                        invisible="state not in ('planned','approved','running')"
                    />

                    <button
                        name="action_check_machine_availability"
                        type="object"
                        string="Check Machine Availability"
                        class="btn-info"
                        invisible="1"
                    />

                    <button
                        name="action_reset_planning"
                        type="object"
                        string="Reset Planning"
                        invisible="state not in ('planned','approved')"
                    />

                    <button
                        name="action_validate_planning"
                        type="object"
                        string="Validate Planning"
                        class="btn-info"
                        invisible="state != 'planned'"
                    />

                    <button
                        name="action_check_material"
                        type="object"
                        string="Check Material Availability"
                        class="btn-info"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,planned,approved,running,done"
                    />
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_manufacturing_orders" type="object"
                                class="oe_stat_button" icon="fa-cogs"
                                invisible="not mo_count">
                            <field name="mo_count" widget="statinfo" string="Perintah Produksi"/>
                        </button>
                        <button name="action_open_deliveries" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="not sale_order_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="delivery_count"/></span>
                                <span class="o_stat_text"><field name="delivery_state"/></span>
                            </div>
                        </button>
                    </div>

                    <group>
                        <group>
                            <field name="name" readonly="state != 'draft'" placeholder="Kosongkan untuk nomor otomatis"/>
                            <field name="sale_order_id"/>
                            <field name="origin_type" readonly="state != 'draft'"/>
                            <field name="mou_id"/>
                            <field name="brand_name"/>
                            <field name="purchase_order_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field
                                name="production_type"
                                widget="badge"
                            />
                            <field
                                name="has_pending_mo"
                                string="Belum Dibuat Perintah Produksi"
                            />
                            <field name="customer_id"/>
                            <field
                                name="is_child_plan"
                                invisible="1"
                            />

                            <field
                                name="has_child_production"
                                invisible="1"
                            />

                            <div
                                class="alert alert-info"
                                role="alert"
                                invisible="not is_child_plan"
                            >
                                <strong>Partial Production</strong>
                            </div>

                            <div
                                class="alert alert-warning"
                                role="alert"
                                invisible="not has_child_production"
                            >
                                <strong>Production sudah di-split</strong>
                            </div>
                        </group>

<!--                        <group>-->
<!--                            <field name="product_id"/>-->
<!--                            <field name="product_qty"/>-->
<!--                            <field name="product_uom_id"/>-->
<!--                        </group>-->
                    </group>

                    <group string="Planning Period">
                        <field name="planned_start" string="Planning Start"/>
                        <field name="planned_end" string="Planning End"/>
                        <field name="progress" widget="progressbar"/>
                    </group>

                    <group>
                        <field name="note"/>
                    </group>

                    <notebook>
                        <page string="Products">
                            <field name="product_line_ids">
                                <list editable="bottom" decoration-muted="production_qty &lt;= 0 and child_product_line_ids">
                                    <field name="product_id" width="300px"/>
                                    <field name="finished_product_id" string="Produk Jadi" width="300px"
                                           optional="show" options="{'no_create': True}"/>
                                    <field name="product_qty" string="Qty" width="110px"/>
                                    <field name="production_qty" string="Qty Produksi" readonly="1" width="130px"/>
                                    <field name="product_uom_id" optional="hide"/>
                                    <field name="production_start" string="Mulai" optional="show"/>
                                    <field name="production_end" string="Selesai" optional="show"/>
                                    <field name="child_allocated_qty" string="Dipecah" optional="hide"/>
                                    <field name="remaining_qty" string="Sisa Split" optional="hide"/>
                                    <field name="production_type" string="Tipe" optional="show"/>

                                    <field name="has_mo" string="Sudah Dibuat" readonly="1" optional="hide"/>
                                    <button name="action_create_mo" type="object" string="Buat MO"
                                            icon="fa-industry" class="btn btn-primary"
                                            invisible="has_mo or production_qty &lt;= 0 or parent.state not in ('approved', 'running')"/>
                                    <button name="action_open_mo" type="object" string="Buka MO"
                                            icon="fa-external-link" class="btn btn-link" invisible="not has_mo"/>
                                    <field name="progress" widget="progressbar" width="120px"/>

                                    <button
                                        name="action_view_child_productions"
                                        type="object"
                                        title="Lihat hasil pecahan produksi"
                                        icon="fa-code-fork"
                                        invisible="not child_product_line_ids"
                                    />
                                    <button
                                        name="action_open_split_wizard"
                                        type="object"
                                        title="Pecah produksi (Split)"
                                        icon="fa-scissors"
                                        invisible="parent_product_line_id or remaining_qty &lt;= 0"
                                    />
                                </list>
                            </field>
                        </page>

                        <page string="Jadwal Proses">
                            <field name="stage_product_line_ids" readonly="1">
                                <list create="0" delete="0" edit="0"
                                      open_form_view="0">
                                    <field name="bom_product_id" string="Produk"/>
                                    <field name="production_qty" string="Qty"/>
                                    <field name="stage_start" string="Mulai"/>
                                    <field name="stage_end" string="Selesai"/>
                                    <field name="stage_progress" string="Tahap"/>
                                    <field name="has_mo" column_invisible="1"/>
                                    <button name="action_open_stage_popup" type="object"
                                            string="Atur Tahapan" icon="fa-calendar"
                                            class="btn btn-link"/>
                                    <button name="action_open_mo" type="object"
                                            string="Buka MO" icon="fa-external-link"
                                            class="btn btn-link" invisible="not has_mo"/>
                                </list>
                            </field>
                            <div class="text-muted">
                                Klik Atur Tahapan di tiap produk untuk mengisi tanggal, PIC, dan mesin per tahap.
                                Setelah Perintah Produksi dibuat, tahap dijalankan dari tab Eksekusi Produksi.
                            </div>
                        </page>

                        <page string="Eksekusi Produksi" invisible="state not in ('running', 'done')">
                            <field name="stage_ids">
                                <list editable="bottom" create="0" delete="0"
                                      decoration-danger="is_late"
                                      decoration-muted="state == 'done'">
                                    <field name="product_id" string="Produk" readonly="1"/>
                                    <field name="batch_label" readonly="1" optional="hide"/>
                                    <field name="stage_id" readonly="1"/>
                                    <field name="date_start" readonly="1"/>
                                    <field name="date_end" readonly="1"/>
                                    <field name="is_late" column_invisible="1"/>
                                    <field name="user_id" readonly="1" string="PIC"/>
                                    <field name="machine_id" readonly="1"/>
                                    <field name="workorder_id" readonly="1" optional="show"/>
                                    <field name="material_state" widget="badge" decoration-danger="material_state == 'short'"
                                           decoration-success="material_state == 'ok'"/>
                                    <field name="qty_good" readonly="state != 'in_progress'"/>
                                    <field name="qty_reject" readonly="state != 'in_progress'"/>
                                    <field name="set_batch" column_invisible="1"/>
                                    <field name="batch_no" readonly="not set_batch or state != 'in_progress'" optional="hide"/>
                                    <field name="expiry_date" readonly="not set_batch or state != 'in_progress'" optional="hide"/>
                                    <field name="state" widget="badge" decoration-success="state == 'done'"
                                           decoration-info="state == 'in_progress'" decoration-warning="state == 'waiting_qc'"/>
                                    <field name="qc_state" widget="badge" decoration-success="qc_state == 'passed'"
                                           decoration-danger="qc_state == 'failed'"/>
                                    <field name="has_checks" column_invisible="1"/>
                                    <button name="action_start" type="object" string="Mulai" icon="fa-play"
                                            invisible="state != 'todo' or material_state == 'short'"/>
                                    <button name="action_show_material" type="object" string="Bahan kurang - lihat detail"
                                            icon="fa-exclamation-triangle" class="text-danger"
                                            invisible="state != 'todo' or material_state != 'short'"/>
                                    <button name="action_submit_qc" type="object" string="Ajukan QC" icon="fa-paper-plane"
                                            invisible="state != 'in_progress'"/>
                                    <button name="action_open_checks" type="object" string="Isi Parameter QC" icon="fa-list-alt"
                                            invisible="state != 'waiting_qc' or not has_checks"
                                            groups="custom_production_planning.group_production_qc,base.group_system"/>
                                    <button name="action_qc_pass" type="object" string="QC Lulus" icon="fa-check"
                                            invisible="state != 'waiting_qc'"
                                            groups="custom_production_planning.group_production_qc,base.group_system"/>
                                    <button name="action_qc_fail" type="object" string="QC Gagal" icon="fa-times"
                                            invisible="state != 'waiting_qc'"
                                            groups="custom_production_planning.group_production_qc,base.group_system"/>
                                    <button name="action_open_mo" type="object" string="Buka MO" icon="fa-external-link"/>
                                    <button name="action_open_workorder" type="object" string="Buka Work Order"
                                            icon="fa-cogs" invisible="not workorder_id"/>
                                </list>
                            </field>
                            <div class="text-muted">
                                Semua produk dalam plan ini dikerjakan dari sini. Tahap dikerjakan berurutan per produk,
                                dan setelah Ajukan QC, petugas QC memeriksa dari Antrean QC. QC lulus membuka tahap berikutnya.
                                Baris merah = melewati tanggal selesai rencana.
                            </div>
                        </page>

                        <page string="Operations" invisible="stage_ids">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field
                                        name="product_id"
                                        readonly="1"
                                    />

                                    <field
                                        name="operation_id"
                                        readonly="1"
                                    />

                                    <field
                                        name="workcenter_id"
                                        readonly="1"
                                    />

                                    <field name="machine_id"/>
                                    <field name="capacity_id"/>
                                    <field name="qty_plan"/>
                                    <field name="capacity_per_day" string="Kapasitas/Hari"/>
                                    <field name="production_start" optional="show"/>
                                    <field name="production_end" optional="show"/>
                                    <field name="days_needed"
                                           decoration-danger="days_needed &gt; days_available"/>
                                    <field name="days_available"/>
                                    <field
                                        name="capacity_warning"
                                        decoration-danger="capacity_warning"
                                    />
                                    <field name="workorder_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <page string="Material Availability">
                            <field name="material_shortage_ids" readonly="1">
                                <list>
                                    <field
                                        name="finished_product_id"
                                        string="Produk Jadi"
                                    />
                                    <field
                                        name="product_id"
                                        string="Material"
                                    />
                                    <field name="required_qty"/>
                                    <field name="available_qty"/>
                                    <field name="shortage_qty"/>
                                </list>
                            </field>
                        </page>

                        <page string="Machine Schedule" invisible="stage_ids">
                            <field
                                name="machine_schedule_ids"
                                readonly="1"
                            >
                                <list>
                                    <field name="product_id" string="Product"/>
                                    <field name="operation_id"/>
                                    <field name="machine_id"/>
                                    <field name="workorder_id"/>
                                    <field name="capacity_id"/>
                                    <field name="planned_qty"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>

                        <page string="Perintah Produksi">
                            <field name="manufacturing_order_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="product_qty"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>


<!--                        <page-->
<!--                            string="Partial Production"-->
<!--                            invisible="parent_plan_id"-->
<!--                        >-->
<!--                            <field name="child_plan_ids">-->
<!--                                <list>-->
<!--                                    <field name="production_number"/>-->
<!--                                    <field name="production_po_number"/>-->
<!--                                    <field name="product_id"/>-->
<!--                                    <field name="product_qty"/>-->
<!--                                    <field name="planned_start"/>-->
<!--                                    <field name="planned_end"/>-->
<!--                                    <field name="state"/>-->
<!--                                </list>-->
<!--                            </field>-->
<!--                        </page>-->
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_production_plan" model="ir.actions.act_window">
        <field name="name">Production Planning</field>
        <field name="res_model">mrp.production.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>