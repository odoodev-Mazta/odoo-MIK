<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_purchase_request_form_deadline" model="ir.ui.view">
        <field name="name">purchase.request.form.deadline</field>
        <field name="model">purchase.request</field>
        <field name="inherit_id" ref="custom_purchase_request.view_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="arrival_warning" invisible="1"/>
                <div class="alert alert-danger mb-0" role="alert" invisible="not arrival_warning">
                    <field name="arrival_warning" nolabel="1"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='estimated_date']" position="after">
                <field name="production_deadline" invisible="not production_deadline"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_form_deadline" model="ir.ui.view">
        <field name="name">purchase.order.form.deadline</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="arrival_warning" invisible="1"/>
                <div class="alert alert-danger mb-0" role="alert" invisible="not arrival_warning">
                    <field name="arrival_warning" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
