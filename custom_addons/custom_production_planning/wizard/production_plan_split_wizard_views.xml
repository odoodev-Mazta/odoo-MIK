<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_production_plan_split_wizard_form" model="ir.ui.view">
        <field name="name">mrp.production.plan.split.wizard.form</field>
        <field name="model">mrp.production.plan.split.wizard</field>
        <field name="arch" type="xml">

            <form string="Split Production">

                <group>
                    <field name="product_line_id"/>
                    <field name="production_number"/>
                    <field name="product_id"/>
                </group>

                <group>
                    <field name="total_qty"/>
                    <field name="allocated_qty"/>
                    <field name="remaining_qty"/>
                    <field name="split_qty"/>
                </group>

                <group string="Production Schedule">
                    <field name="production_start"/>
                    <field name="production_end"/>
                </group>

                <footer>
                    <button
                        name="action_split"
                        type="object"
                        string="Create Partial Production"
                        class="btn-primary"
                    />

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>

            </form>

        </field>
    </record>

</odoo>