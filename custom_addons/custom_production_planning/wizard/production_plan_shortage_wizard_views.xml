<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_plan_shortage_wizard_form" model="ir.ui.view">
        <field name="name">mrp.production.plan.shortage.wizard.form</field>
        <field name="model">mrp.production.plan.shortage.wizard</field>
        <field name="arch" type="xml">
            <form string="Stok Bahan Kurang">
                <div class="alert alert-warning" role="alert">
                    Beberapa bahan belum cukup di stok. Plan tetap bisa dibuat, tetapi
                    Perintah Produksi akan menunggu bahan sampai stoknya masuk.
                </div>
                <field name="plan_id" invisible="1"/>
                <field name="shortage_html" nolabel="1"/>
                <p>Lanjutkan membuat Plan Produksi?</p>
                <footer>
                    <button name="action_confirm" type="object" string="Ya, Lanjutkan"
                            class="btn-primary"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
