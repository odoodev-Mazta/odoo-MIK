<templates xml:space="preserve">

    <t t-name="custom_production_planning.ProductionDonutChart" owl="1">
        <div class="card shadow-sm production-donut-card">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="production-donut-card-title" t-esc="props.title"/>
                    <span class="text-muted small"><t t-esc="props.total"/> MO</span>
                </div>

                <div class="d-flex align-items-center production-donut-card-body">

                    <div class="production-donut-canvas-wrap">
                        <canvas t-ref="canvas"/>
                    </div>

                    <div class="production-donut-legend">
                        <t t-foreach="props.segments" t-as="segment" t-key="segment.key">
                            <div class="production-legend-item">
                                <span
                                    class="status-dot"
                                    t-att-style="'background-color: ' + segment.color + ';'"
                                />
                                <span class="production-legend-label" t-esc="segment.label"/>
                                <span class="production-legend-value">
                                    <t t-esc="segment.count"/>
                                    <span class="text-muted">(<t t-esc="segment.percentage"/>%)</span>
                                </span>
                            </div>
                        </t>
                    </div>

                </div>

            </div>
        </div>
    </t>

    <t t-name="custom_production_planning.ProductionDashboard" owl="1">
        <div class="o_production_dashboard p-4">

            <!-- HEADER -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="mb-1">Production Dashboard</h2>
                </div>

                <button class="btn btn-primary" t-on-click="refresh">
                    <i class="fa fa-refresh me-1"/>
                    Refresh
                </button>
            </div>

            <!-- DONUT ROW -->
            <div class="production-donut-row mb-3">
                <t t-foreach="donutCards" t-as="donut" t-key="donut.title">
                    <ProductionDonutChart
                        title="donut.title"
                        total="donut.total"
                        segments="donut.segments"
                    />
                </t>
            </div>

            <!-- PRODUCTION TABLE -->
            <div class="card shadow-sm production-dashboard-table">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3 production-dashboard-table-header">
                        <div>
                            <h5 class="mb-1">Production Progress</h5>
                        </div>

                        <span class="badge bg-secondary">
                            <t t-esc="state.data.length"/> MO
                        </span>
                    </div>

                    <div class="table-responsive production-dashboard-table-container">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>MO Number</th>
                                    <th>Product</th>
                                    <th>Customer</th>
                                    <th>Current Work Order</th>
                                    <th style="width: 180px;">Progress</th>
                                    <th>Next Work Order</th>
                                    <th>Status</th>
                                    <th>Planned Start</th>
                                    <th>Planned End</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="state.data.length">
                                    <t t-foreach="state.data" t-as="record" t-key="record.id">
                                        <tr>
                                            <td>
                                                <strong><t t-esc="record.mo_name"/></strong>
                                            </td>

                                            <td>
                                                <t t-esc="record.product_id ? record.product_id[1] : ''"/>
                                            </td>

                                            <td>
                                                <t t-esc="record.customer_id ? record.customer_id[1] : ''"/>
                                            </td>

                                            <td>
                                                <t t-esc="record.current_workorder || '-'"/>
                                            </td>

                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="progress flex-grow-1" style="height: 8px;">
                                                        <div
                                                            class="progress-bar"
                                                            role="progressbar"
                                                            t-att-style="'width: ' + (record.workorder_progress || 0) + '%;'"
                                                        />
                                                    </div>
                                                    <span class="ms-2 small">
                                                        <t t-esc="Math.round(record.workorder_progress || 0)"/>%
                                                    </span>
                                                </div>
                                            </td>

                                            <td>
                                                <t t-esc="record.next_workorder || '-'"/>
                                            </td>

                                            <td>
                                                <span
                                                    class="badge"
                                                    t-att-class="
                                                        record.workorder_status === 'done'
                                                        ? 'bg-success'
                                                        : record.workorder_status === 'running'
                                                        ? 'bg-primary'
                                                        : 'bg-warning text-dark'
                                                    "
                                                >
                                                    <t t-esc="record.workorder_status || '-'"/>
                                                </span>
                                            </td>

                                            <td>
                                                <t t-esc="record.planned_start || '-'"/>
                                            </td>

                                            <td>
                                                <t t-esc="record.planned_end || '-'"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>

                                <t t-else="">
                                    <tr>
                                        <td colspan="9" class="text-center text-muted py-5">
                                            No production data available.
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>