<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_form_inherit_marketing" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.marketing</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="marketing_sequence"/>
            </xpath>

            <xpath expr="//header" position="inside">
                <button
                    name="action_send_to_production"
                    type="object"
                    string="Send to Production"
                    class="btn-primary"
                />
            </xpath>

        </field>
    </record>

</odoo>