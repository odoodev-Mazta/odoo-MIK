<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="custom_bom.ImportProgress">
        <div class="p-4">
            <h5 class="mb-3">
                <t t-if="state.error">Import terhenti</t>
                <t t-elif="state.finished">Import selesai</t>
                <t t-else="">Sedang mengimpor BoM...</t>
            </h5>

            <div class="progress mb-2" style="height: 22px;">
                <div class="progress-bar"
                     t-att-class="state.error ? 'bg-danger' : (state.finished ? 'bg-success' : 'progress-bar-striped progress-bar-animated')"
                     role="progressbar"
                     t-att-style="'width: ' + percent + '%'">
                    <t t-esc="percent"/>%
                </div>
            </div>
            <div class="text-muted mb-3">
                <t t-esc="state.processed"/> dari <t t-esc="state.total"/> BoM diproses
            </div>

            <div>
                Dibuat: <b t-esc="state.created"/> ·
                Diperbarui: <b t-esc="state.updated"/> ·
                Dilewati (sudah ada): <b t-esc="state.skipped"/>
                <t t-if="state.newProducts"> · Produk baru: <b t-esc="state.newProducts"/></t>
            </div>

            <div t-if="state.error" class="alert alert-danger mt-3" style="white-space: pre-wrap;">
                <t t-esc="state.error"/>
                <div class="mt-2">
                    BoM yang sudah diproses sebelum error tetap tersimpan.
                    Perbaiki masalahnya lalu import ulang (mode "Lewati" akan melewati yang sudah ada).
                </div>
            </div>

            <div class="mt-4" t-if="state.finished or state.error">
                <button class="btn btn-primary" t-on-click="close">Tutup</button>
            </div>
            <div class="mt-3 text-muted small" t-else="">
                Jangan tutup halaman ini sampai selesai.
            </div>
        </div>
    </t>

</templates>
