<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form_inherit_mou" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.mou</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[hasclass('oe_title')]//field[@name='name']" position="attributes">
                <attribute name="readonly">state not in ('draft', 'sent')</attribute>
                <attribute name="placeholder">Ketik No. SO...</attribute>
            </xpath>

            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="mou_id" options="{'no_create': True}"/>
                <field name="brand_name"/>
                <field name="timeline_stage" readonly="1" invisible="not timeline_stage"/>
                <field name="is_repeat_order" widget="boolean_toggle"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_mou_payments" type="object"
                        class="oe_stat_button" icon="fa-money"
                        invisible="not mou_id">
                    <field name="mou_payment_count" widget="statinfo" string="Payments"/>
                </button>
            </xpath>

        </field>
    </record>

    <record id="view_move_form_inherit_mou" model="ir.ui.view">
        <field name="name">account.move.form.inherit.mou</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="mou_id" invisible="move_type == 'entry'"/>
                <field name="timeline_stage" readonly="1" invisible="move_type == 'entry' or not timeline_stage"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_register_form_inherit_mou" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit.mou</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group1']/field[@name='journal_id']" position="before">
                <field name="mou_invoice_id" invisible="1"/>
                <field name="mou_id" invisible="not mou_id"/>
                <field name="timeline_stage" invisible="not mou_id" required="mou_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_form_inherit_mou" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.mou</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- Semua kontak bisa dipilih (termasuk perorangan di bawah perusahaan, mis. dokter) -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[]</attribute>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="mou_id" options="{'no_create': True}"
                       invisible="payment_type != 'inbound' or partner_type != 'customer'"
                       readonly="state != 'draft'"/>
                <field name="timeline_stage"
                       invisible="payment_type != 'inbound' or partner_type != 'customer'"
                       required="mou_id"
                       readonly="state != 'draft'"/>
                <field name="sale_invoice_id" options="{'no_create': True}"
                       invisible="timeline_stage not in ('dp', 'bp')"
                       required="timeline_stage in ('dp', 'bp')"
                       readonly="state != 'draft'"/>
                <field name="sale_order_id" readonly="1"
                       invisible="timeline_stage not in ('dp', 'bp') or not sale_order_id"/>
                <field name="bukti_bayar_ids" widget="many2many_binary"
                       invisible="not mou_id"/>
            </xpath>
            <xpath expr="//sheet/group[1]" position="before">
                <div class="alert alert-info" role="alert"
                     invisible="timeline_stage not in ('dp', 'bp') or not sale_invoice_id">
                    <strong>Info Tagihan Invoice</strong>
                    <div class="d-flex flex-wrap gap-4 mt-1">
                        <span>Total Invoice:
                            <field name="sale_invoice_total" nolabel="1"/>
                        </span>
                        <span>Sudah Dibayar:
                            <field name="sale_invoice_paid" nolabel="1"/>
                        </span>
                        <span>
                            <strong>Sisa Tagihan:
                                <field name="so_outstanding_amount" nolabel="1" class="text-danger fw-bold"/>
                            </strong>
                        </span>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>