<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_import_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.import.wizard.form</field>
        <field name="model">sale.order.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Sales Order">
                <div class="alert alert-info" role="alert">
                    Belum punya filenya? Klik <b>Download Format</b> untuk mengunduh contoh file Excel
                    beserta petunjuk pengisiannya. Satu baris = satu produk di SO.
                    SO dibuat sebagai Quotation, dan No. SO yang sudah ada dilewati.
                    Semua baris diperiksa dulu; bila ada satu saja yang salah, tidak ada yang diimpor.
                </div>
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button string="Import" name="action_import" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Download Format" name="action_download_format" type="object" class="btn-secondary"/>
                    <button string="Batal" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- sale_order_tree adalah dasar dari daftar Quotation dan Sales Order -->
    <record id="view_sale_order_list_import_export" model="ir.ui.view">
        <field name="name">sale.order.list.import.export</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_import_so" type="object" string="Import SO" display="always"/>
                <button name="action_export_so" type="object" string="Export SO" display="always"/>
                <button name="action_download_so_format" type="object" string="Format Import" display="always"/>
            </xpath>
        </field>
    </record>

</odoo>
