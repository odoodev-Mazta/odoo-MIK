<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_design_usulan_form_inherit_registrasi" model="ir.ui.view">
        <field name="name">design.usulan.form.inherit.registrasi</field>
        <field name="model">design.usulan</field>
        <field name="inherit_id" ref="custom_design.view_design_usulan_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_registrasi_produk"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-flask"
                        invisible="registrasi_produk_count == 0">
                    <field name="registrasi_produk_count" widget="statinfo" string="Registrasi Produk"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>