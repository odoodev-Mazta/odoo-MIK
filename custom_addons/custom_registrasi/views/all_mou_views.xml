<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_all_mou_registrasi_list" model="ir.ui.view">
        <field name="name">draft.maklon.registrasi.list</field>
        <field name="model">draft.maklon</field>
        <field name="arch" type="xml">
            <list string="All MOU" create="0" delete="0" edit="0">
                <field name="draft_name" string="No. MOU"/>
                <field name="nama_cust" string="Customer"/>
                <field name="brand"/>
                <field name="state" widget="badge" string="Status MOU"/>
                <field name="reg_brand_state" widget="badge"
                       decoration-success="reg_brand_state == 'approved'"
                       decoration-danger="reg_brand_state == 'rejected'"
                       decoration-muted="reg_brand_state == 'none'"
                       decoration-info="reg_brand_state not in ('approved', 'rejected', 'none')"/>
                <field name="reg_nie_state" widget="badge"
                       decoration-success="reg_nie_state == 'nie_issued'"
                       decoration-danger="reg_nie_state == 'failed'"
                       decoration-muted="reg_nie_state == 'none'"
                       decoration-info="reg_nie_state not in ('nie_issued', 'failed', 'none')"/>
                <field name="reg_nie_numbers"/>
                <field name="reg_halal_state" widget="badge"
                       decoration-success="reg_halal_state == 'sertifikat_terbit'"
                       decoration-danger="reg_halal_state in ('ditolak', 'kadaluarsa')"
                       decoration-muted="reg_halal_state == 'none'"
                       decoration-info="reg_halal_state not in ('sertifikat_terbit', 'ditolak', 'kadaluarsa', 'none')"/>
            </list>
        </field>
    </record>

    <record id="view_all_mou_registrasi_search" model="ir.ui.view">
        <field name="name">draft.maklon.registrasi.search</field>
        <field name="model">draft.maklon</field>
        <field name="arch" type="xml">
            <search>
                <field name="draft_name" string="No. MOU"/>
                <field name="nama_cust" string="Customer"/>
                <field name="brand"/>
                <filter name="is_mou" string="MOU" domain="[('state', '=', 'mou')]"/>
                <filter name="is_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
            </search>
        </field>
    </record>

    <record id="action_all_mou_registrasi" model="ir.actions.act_window">
        <field name="name">All MOU</field>
        <field name="res_model">draft.maklon</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_all_mou_registrasi_list')})]"/>
        <field name="search_view_id" ref="view_all_mou_registrasi_search"/>
        <field name="context">{'search_default_is_mou': 1}</field>
    </record>

    <menuitem id="menu_registrasi_all_mou"
        name="All MOU"
        parent="menu_registrasi_root"
        action="action_all_mou_registrasi"
        sequence="15"/>

</odoo>
