<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════
         FORM VIEW – design.usulan
    ═══════════════════════════════════════════════════ -->
    <record id="view_design_usulan_form" model="ir.ui.view">
        <field name="name">design.usulan.form</field>
        <field name="model">design.usulan</field>
        <field name="arch" type="xml">
            <form string="Usulan Design">

                <!-- ── HEADER ── -->
                <header>
                    <!-- Draft → On Progress -->
                    <button name="action_submit_form_design"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <!-- On Progress → Approval Marketing -->
                    <button name="action_submit_to_approval"
                            string="Ajukan ke Approval"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'progress'"/>

                    <!-- Approval Marketing -->
                    <button name="action_approve_marketing"
                            string="Approve"
                            type="object"
                            class="btn-success"
                            invisible="state != 'approval_marketing'"/>

                    <!-- Approval Client -->
                    <button name="action_approve_client"
                            string="Approve"
                            type="object"
                            class="btn-success"
                            invisible="state != 'approval_client'"/>

                    <!-- Approval RO -->
                    <button name="action_approve_ro"
                            string="Approve"
                            type="object"
                            class="btn-success"
                            invisible="state != 'approval_ro'"/>

                    <!-- Upload Form Design -->
                    <button name="action_upload_done"
                            string="Submit Form Design Final"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'upload_form'"/>

                    <!-- Revisi -->
                    <button name="action_revisi_design"
                            string="Revisi"
                            type="object"
                            class="btn-warning"
                            invisible="state not in ('done','approval_marketing','approval_client','approval_ro','upload_form')"
                            confirm="Revisi akan mereset semua approval dan mengembalikan ke On Progress. Lanjutkan?"/>

                    <!-- Reject -->
                    <button name="action_reject"
                            string="Reject"
                            type="object"
                            class="btn-danger"
                            invisible="state not in ('approval_marketing','approval_client','approval_ro','upload_form')"/>

                    <!-- STATUSBAR: hanya 5 tahap utama -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,progress,approval_marketing,upload_form,done"/>
                </header>

                <!-- ── BODY ── -->
                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_revisi_design"
                                icon="fa-refresh"
                                invisible="revisi_count == 0">
                            <field name="revisi_count" widget="statinfo" string="Revisi"/>
                        </button>
                    </div>

                    <!-- Banner: tahap approval saat ini (muncul hanya saat state approval) -->
                    <div invisible="state not in ('approval_marketing','approval_client','approval_ro')"
                         style="margin-bottom: 12px;">
                        <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">

                            <!-- Step 1: Marketing -->
                            <div style="display:flex; align-items:center; gap:6px; padding:6px 14px; border-radius:20px; font-size:13px; font-weight:600;"
                                 invisible="state not in ('approval_marketing','approval_client','approval_ro')"
                                 t-attf-style="background: {{'#198754' if state in ('approval_client','approval_ro') else '#0d6efd' if state == 'approval_marketing' else '#dee2e6'}}20; border: 1.5px solid {{'#198754' if state in ('approval_client','approval_ro') else '#0d6efd' if state == 'approval_marketing' else '#dee2e6'}}; color: {{'#198754' if state in ('approval_client','approval_ro') else '#0d6efd' if state == 'approval_marketing' else '#6c757d'}};"> 
                                <i class="fa fa-bullhorn"/> Manager Marketing
                                <span invisible="state == 'approval_marketing'"> ✓</span>
                            </div>

                            <i class="fa fa-chevron-right text-muted" style="font-size:11px;"/>

                            <!-- Step 2: Client -->
                            <div style="display:flex; align-items:center; gap:6px; padding:6px 14px; border-radius:20px; font-size:13px; font-weight:600;"
                                 invisible="state not in ('approval_marketing','approval_client','approval_ro')">
                                <i class="fa fa-user-circle"/>
                                Client
                                <span invisible="state != 'approval_ro'"> ✓</span>
                            </div>

                            <i class="fa fa-chevron-right text-muted" style="font-size:11px;"/>

                            <!-- Step 3: RO -->
                            <div style="display:flex; align-items:center; gap:6px; padding:6px 14px; border-radius:20px; font-size:13px; font-weight:600;"
                                 invisible="state not in ('approval_marketing','approval_client','approval_ro')">
                                <i class="fa fa-shield"/> RO
                            </div>

                            <!-- Label tahap aktif -->
                            <span class="ms-3 fw-bold" style="font-size:13px; color:#6c757d;"
                                  invisible="state != 'approval_marketing'">← Menunggu persetujuan Manager Marketing</span>
                            <span class="ms-3 fw-bold" style="font-size:13px; color:#6c757d;"
                                  invisible="state != 'approval_client'">← Menunggu persetujuan Client</span>
                            <span class="ms-3 fw-bold" style="font-size:13px; color:#6c757d;"
                                  invisible="state != 'approval_ro'">← Menunggu persetujuan RO</span>
                        </div>
                    </div>

                    <!-- Banner Reject -->
                    <div class="alert alert-danger mb-3" role="alert"
                         invisible="state != 'reject'">
                        <strong>Ditolak</strong>
                        <span invisible="not reject_reason"> — <field name="reject_reason" readonly="1"/></span>
                        <span class="text-muted ms-2">oleh <field name="rejected_by" readonly="1"/> pada <field name="rejected_date" readonly="1"/></span>
                    </div>

                    <!-- Banner Upload Form -->
                    <div class="alert alert-info mb-3" role="alert"
                         invisible="state != 'upload_form'">
                        <strong>RO telah menyetujui.</strong>
                        Silakan upload Form Design Final dan klik Submit Form Design Final.
                    </div>

                    <!-- Title -->
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- ── MAIN FIELDS ── -->
                    <group>
                        <group string="Informasi Design">
                            <field name="date"
                                   readonly="state not in ('draft','progress')"/>
                            <field name="partner_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="mou_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True}"
                                   domain="[('state','=','mou'),('nama_cust','=',partner_id)]"/>
                            <field name="brand"
                                   readonly="state not in ('draft','progress')"/>
                        </group>
                        <group string="Status &amp; Waktu">
                            <field name="date_done" readonly="1"/>
                            <field name="is_ontime" readonly="state != 'done'"/>
                            <field name="revisi_count" readonly="1"/>
                        </group>
                    </group>

                    <!-- ── NOTEBOOK ── -->
                    <notebook>
                        <page string="Produk" name="produk">
                            <field name="product_line_ids"
                                   readonly="state not in ('draft','progress')"
                                   widget="one2many_list">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="nama_produk"/>
                                    <field name="kemasan"/>
                                    <field name="keterangan"/>
                                    <field name="attachment" widget="binary" optional="show"/>
                                    <field name="attachment_fname" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <page string="File Design" name="file_design">
                            <group>
                                <field name="attachment_design"
                                       widget="binary"
                                       filename="attachment_design_fname"
                                       readonly="state not in ('progress',)"/>
                                <field name="attachment_design_fname"
                                       invisible="not attachment_design"/>
                            </group>
                        </page>

                        <page string="Form Design Final" name="form_design_final"
                              invisible="state not in ('upload_form','done')">
                            <group>
                                <field name="attachment_form"
                                       widget="binary"
                                       filename="attachment_form_fname"
                                       readonly="state != 'upload_form'"/>
                                <field name="attachment_form_fname"
                                       invisible="not attachment_form"/>
                            </group>
                        </page>

                        <page string="Revisi" name="revisi">
                            <group string="Riwayat Revisi">
                                <field name="revisi_count" string="Total Revisi" readonly="1"/>
                            </group>
                            <field name="revisi_line_ids" readonly="1">
                                <list>
                                    <field name="revisi_ke"/>
                                    <field name="tanggal"/>
                                    <field name="user_id"/>
                                    <field name="state_from"/>
                                    <field name="catatan"/>
                                </list>
                            </field>
                        </page>

                        <page string="Riwayat Approval" name="approval">
                            <group string="Approval Marketing">
                                <field name="approved_by_marketing" readonly="1"/>
                                <field name="approved_by_marketing_date" readonly="1"/>
                            </group>
                            <group string="Approval Client">
                                <field name="approved_by_client" readonly="1"/>
                                <field name="approved_by_client_date" readonly="1"/>
                            </group>
                            <group string="Approval RO">
                                <field name="approved_by_ro" readonly="1"/>
                                <field name="approved_by_ro_date" readonly="1"/>
                            </group>
                            <group string="Penolakan" invisible="state != 'reject'">
                                <field name="rejected_by" readonly="1"/>
                                <field name="rejected_date" readonly="1"/>
                                <field name="reject_reason" readonly="1"/>
                            </group>
                        </page>

                        <page string="Catatan" name="catatan">
                            <field name="notes"
                                   placeholder="Tulis catatan tambahan di sini..."
                                   readonly="state == 'done'"/>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════
         LIST VIEW
    ═══════════════════════════════════════════════════ -->
    <record id="view_design_usulan_list" model="ir.ui.view">
        <field name="name">design.usulan.list</field>
        <field name="model">design.usulan</field>
        <field name="arch" type="xml">
            <list string="Usulan Design"
                  decoration-danger="state=='reject'"
                  decoration-success="state=='done'"
                  decoration-warning="state=='progress'">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="mou_id"/>
                <field name="brand"/>
                <field name="revisi_count" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state=='done'"
                       decoration-warning="state in ('progress','upload_form')"
                       decoration-info="state in ('approval_marketing','approval_client','approval_ro')"
                       decoration-danger="state=='reject'"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════
         SEARCH VIEW
    ═══════════════════════════════════════════════════ -->
    <record id="view_design_usulan_search" model="ir.ui.view">
        <field name="name">design.usulan.search</field>
        <field name="model">design.usulan</field>
        <field name="arch" type="xml">
            <search string="Cari Usulan Design">
                <field name="name" string="No. Design"/>
                <field name="partner_id" string="Pelanggan"/>
                <field name="mou_id" string="No. MOU"/>
                <field name="brand" string="Brand"/>
                <separator/>
                <filter string="Draft"              name="filter_draft"    domain="[('state','=','draft')]"/>
                <filter string="On Progress"        name="filter_progress" domain="[('state','=','progress')]"/>
                <filter string="Approval Marketing" name="filter_mkt"      domain="[('state','=','approval_marketing')]"/>
                <filter string="Approval Client"    name="filter_client"   domain="[('state','=','approval_client')]"/>
                <filter string="Approval RO"        name="filter_ro"       domain="[('state','=','approval_ro')]"/>
                <filter string="Upload Form"        name="filter_upload"   domain="[('state','=','upload_form')]"/>
                <filter string="Done"               name="filter_done"     domain="[('state','=','done')]"/>
                <filter string="Rejected"           name="filter_reject"   domain="[('state','=','reject')]"/>
                <separator/>
                <filter string="Ada Revisi" name="filter_revisi" domain="[('revisi_count','>',0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status"    name="group_state"   context="{'group_by':'state'}"/>
                    <filter string="Pelanggan" name="group_partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Brand"     name="group_brand"   context="{'group_by':'brand'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════
         ACTION – Usulan (Draft, On Progress, Reject)
    ═══════════════════════════════════════════════════ -->
    <record id="action_design_usulan" model="ir.actions.act_window">
        <field name="name">Usulan</field>
        <field name="res_model">design.usulan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_design_usulan_search"/>
        <field name="domain">[('state', 'in', ['draft', 'progress', 'reject'])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Buat Usulan Design baru!</p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════
         ACTION – Approval
    ═══════════════════════════════════════════════════ -->
    <record id="action_design_approval" model="ir.actions.act_window">
        <field name="name">Approval</field>
        <field name="res_model">design.usulan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_design_usulan_search"/>
        <field name="domain">[('state', 'in', ['approval_marketing', 'approval_client', 'approval_ro', 'upload_form', 'done'])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada usulan yang masuk tahap approval.</p>
        </field>
    </record>

</odoo>
