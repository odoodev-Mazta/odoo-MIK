<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. INHERIT FORM BACKEND -->
    <record id="view_order_form_inherit_mazta" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.mazta</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Informasi Mazta">
                    <group>
                        <field name="custom_notes"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>