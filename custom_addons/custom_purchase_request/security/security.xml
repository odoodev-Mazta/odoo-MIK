<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Tampil sebagai baris tersendiri "Purchase Request" di tab Access Rights (bagian Supply Chain) -->
    <record id="res_groups_privilege_purchase_request" model="res.groups.privilege">
        <field name="name">Purchase Request</field>
        <field name="sequence">9</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_pr_approver" model="res.groups">
        <field name="name">PR Approver</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_purchase_request"/>
        <field name="comment">Boleh menyetujui atau menolak Purchase Request.</field>
    </record>

    <!-- Administrator otomatis menjadi PR Approver -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_pr_approver'))]"/>
    </record>

    <record id="purchase_request_company_rule" model="ir.rule">
        <field name="name">Purchase Request Multi Company</field>
        <field name="model_id" ref="model_purchase_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">
            [('company_id', 'in', company_ids)]
        </field>
    </record>

</odoo>