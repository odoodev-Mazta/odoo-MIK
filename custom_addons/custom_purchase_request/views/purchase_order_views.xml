<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header/field[@name='state']" position="before">
                <field name="has_active_usulan_dana" invisible="1"/>
                <button name="action_create_usulan_dana" string="Buat Usulan Dana" type="object"
                        class="btn-primary" invisible="state != 'purchase' or has_active_usulan_dana"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_view_usulan_dana" type="object"
                        icon="fa-money" invisible="not usulan_dana_count">
                    <field name="usulan_dana_count" widget="statinfo" string="Usulan Dana"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="purchase_request_id" options="{'no_create': True}" readonly="state not in ('draft', 'sent')"/>
                <field name="recommended_vendor_ids" invisible="1"/>
                <field name="recommended_vendor_id" options="{'no_create': True, 'no_open': True}"
                       invisible="not recommended_vendor_ids"
                       readonly="state not in ('draft', 'sent')"
                       placeholder="Pilih dari rekomendasi PR, atau isi Vendor di bawah"/>
                <field name="recommended_vendor_note" invisible="not recommended_vendor_note" class="text-warning"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="customer_id"/>
                <field name="mou_id"/>
                <field name="sale_order_id" options="{'no_create': True}" invisible="not mou_id"/>
            </xpath>

            <!-- input data hari-hari sebelumnya: tanggal konfirmasi bisa diubah selama PO belum di-lock -->
            <xpath expr="//div[@name='date_approve']/field[@name='date_approve']" position="attributes">
                <attribute name="readonly">locked</attribute>
            </xpath>

            <xpath expr="//div[hasclass('oe_title')]//field[@name='name']" position="attributes">
                <attribute name="readonly">state not in ('draft', 'sent')</attribute>
                <attribute name="placeholder">Ketik No. PQ/PO...</attribute>
            </xpath>

            <xpath expr="//page[field[@name='order_line']]" position="after">
                <page string="Item Setup">
                    <field name="setup_line_ids">
                        <list editable="bottom">
                            <field name="setup_item_id"/>
                            <field name="description"/>
                            <field name="item_qty"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>