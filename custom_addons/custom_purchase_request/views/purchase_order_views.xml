<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_undo_merge" string="Batalkan Merge" type="object"
                        invisible="not merged_from_ids or state not in ('draft', 'sent')"
                        confirm="RFQ hasil gabungan ini dibatalkan dan RFQ asalnya aktif kembali. Lanjutkan?"/>
                <field name="has_active_usulan_dana" invisible="1"/>
                <button name="action_create_usulan_dana" string="Buat Usulan Dana" type="object"
                        class="btn-primary" invisible="state != 'purchase' or has_active_usulan_dana"/>
            </xpath>

            <xpath expr="//sheet" position="before">
                <field name="merged_into_id" invisible="1"/>
                <field name="merged_from_ids" invisible="1"/>
                <div class="alert alert-info mb-0" role="alert" invisible="not merged_into_id or state == 'cancel'">
                    RFQ ini sudah digabung ke <field name="merged_into_id" readonly="1"/>.
                    Batalkan merge di RFQ hasil gabungan untuk mengaktifkannya kembali.
                </div>
                <div class="alert alert-success mb-0" role="alert" invisible="not merged_from_ids">
                    RFQ hasil gabungan dari: <field name="merged_from_ids" widget="many2many_tags" readonly="1"/>
                </div>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_view_usulan_dana" type="object"
                        icon="fa-money" invisible="not usulan_dana_count">
                    <field name="usulan_dana_count" widget="statinfo" string="Usulan Dana"/>
                </button>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="purchase_request_id" string="Pilih PR" options="{'no_create': True}"
                       readonly="state not in ('draft', 'sent')" invisible="customer_line_ids"/>
                <field name="purchase_request_ids" string="No. PR" widget="many2many_tags"
                       readonly="state not in ('draft', 'sent')" domain="[('id', '=', False)]"
                       options="{'no_create': True, 'no_open': True}"
                       invisible="not customer_line_ids"/>
                <field name="recommended_vendor_ids" invisible="1"/>
                <field name="recommended_vendor_id" options="{'no_create': True, 'no_open': True}"
                       invisible="not recommended_vendor_ids"
                       readonly="state not in ('draft', 'sent')"
                       placeholder="Pilih dari rekomendasi PR, atau isi Vendor di bawah"/>
                <field name="recommended_vendor_note" invisible="not recommended_vendor_note" class="text-warning"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="customer_id"/>
                <field name="mou_id"/>
                <field name="sale_order_id" options="{'no_create': True}" invisible="not mou_id"/>
            </xpath>

            <!-- Tanggal purchase: bisa diketik sejak Quotation (input data hari sebelumnya) dan diubah selama PO belum di-lock -->
            <xpath expr="//label[@for='date_approve']" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="string">Tanggal Purchase</attribute>
            </xpath>
            <xpath expr="//div[@name='date_approve']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath expr="//div[@name='date_approve']/field[@name='date_approve']" position="attributes">
                <attribute name="readonly">locked</attribute>
            </xpath>

            <xpath expr="//div[hasclass('oe_title')]//field[@name='name']" position="attributes">
                <attribute name="readonly">state not in ('draft', 'sent')</attribute>
                <attribute name="placeholder">Ketik No. PQ/PO...</attribute>
            </xpath>

            <xpath expr="//page[field[@name='order_line']]" position="after">
                <page string="Customer PR" name="customer_pr">
                    <field name="customer_line_warning" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="not customer_line_warning">
                        <strong>Jumlah belum sama dengan tab Product:</strong>
                        <field name="customer_line_warning" nolabel="1"/>
                    </div>
                    <button name="action_add_requests" type="object" string="Ambil dari PR"
                            class="btn-primary" invisible="state not in ('draft', 'sent')"/>
                    <field name="customer_line_ids" readonly="state not in ('draft', 'sent')">
                        <list editable="bottom">
                            <field name="request_id" options="{'no_create': True}"/>
                            <field name="recommended_vendor_1" optional="show"/>
                            <field name="recommended_vendor_2" optional="hide"/>
                            <field name="vendor_id" optional="hide"/>
                            <field name="mou_id" options="{'no_create': True}"/>
                            <field name="customer_id"/>
                            <field name="sale_order_id" optional="hide" options="{'no_create': True}"/>
                            <field name="product_id"/>
                            <field name="qty"/>
                            <field name="uom_id"/>
                            <field name="po_qty" optional="show"/>
                            <field name="allocate_product_id" options="{'no_create': True}"/>
                            <field name="allocated_qty"/>
                            <button name="action_allocate" type="object" string="Alokasikan"
                                    class="btn btn-link" icon="fa-exchange"
                                    invisible="not id or not allocate_product_id or allocated_qty >= qty"
                                    confirm="Stok produk umum dipindahkan ke produk customer sebanyak sisa qty. Lanjutkan?"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <xpath expr="//page[field[@name='order_line']]" position="after">
                <page string="Item Setup">
                    <field name="setup_line_ids">
                        <list editable="bottom">
                            <field name="setup_item_id"/>
                            <field name="description"/>
                            <field name="item_qty"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>