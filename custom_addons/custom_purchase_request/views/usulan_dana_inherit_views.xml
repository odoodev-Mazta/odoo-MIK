<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tab "Keterangan PO" di Usulan Dana: rincian per No. PO (satu atau lebih PO). -->
    <record id="view_usulan_usulan_dana_form_keterangan_po" model="ir.ui.view">
        <field name="name">usulan.usulan.dana.form.keterangan.po</field>
        <field name="model">usulan.usulan.dana</field>
        <field name="inherit_id" ref="custom_usulandana.view_usulan_usulan_dana_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='item_details']" position="after">
                <page string="Keterangan PO" name="keterangan_po">
                    <separator string="Item di PO (per No. PO)"/>
                    <field name="po_order_line_ids" readonly="1">
                        <list create="0" delete="0" edit="0" open_form_view="0">
                            <field name="order_id" string="No. PO"/>
                            <field name="partner_id" string="Vendor"/>
                            <field name="product_id"/>
                            <field name="name" string="Deskripsi"/>
                            <field name="product_qty" string="Qty"/>
                            <field name="product_uom_id" string="Unit"/>
                            <field name="price_unit" string="Price"/>
                            <field name="currency_id" string="Currency"/>
                            <field name="price_subtotal" string="Subtotal"/>
                        </list>
                    </field>

                    <separator string="Pembagian untuk Customer (Keterangan PR di PO)"/>
                    <field name="po_customer_line_ids" readonly="1">
                        <list create="0" delete="0" edit="0" open_form_view="0">
                            <field name="order_id" string="No. PO"/>
                            <field name="request_id"/>
                            <field name="customer_id"/>
                            <field name="mou_id"/>
                            <field name="sale_order_id"/>
                            <field name="product_id"/>
                            <field name="description"/>
                            <field name="qty"/>
                            <field name="uom_id"/>
                            <field name="allocate_product_id" string="Alokasi ke Produk"/>
                            <field name="allocation_state" string="Status Alokasi"/>
                        </list>
                    </field>
                    <div class="text-muted">
                        Pilih satu atau lebih No. PO di bagian Purchase Order. Rincian di sini mengikuti PO tersebut.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
