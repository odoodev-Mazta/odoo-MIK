<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_design_file_preview_form" model="ir.ui.view">
        <field name="name">design.file.preview.form</field>
        <field name="model">design.file.preview</field>
        <field name="arch" type="xml">
            <form string="Preview File" create="0" edit="0">
                <field name="kind" invisible="1"/>
                <field name="file" widget="pdf_viewer" nolabel="1" invisible="kind != 'pdf'"/>
                <field name="image" widget="image" nolabel="1" class="d-block text-center"
                       invisible="kind != 'image'"/>
                <div class="alert alert-info" role="alert" invisible="kind != 'other'">
                    File jenis ini tidak bisa ditampilkan. Gunakan tombol Download.
                </div>
                <footer>
                    <button name="action_download" type="object" string="Download" class="btn-primary"
                            icon="fa-download"/>
                    <button string="Tutup" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
